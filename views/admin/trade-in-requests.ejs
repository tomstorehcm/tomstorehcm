<!doctype html>
<html lang="vi">
<head>
<%- include('partials/head') %>
</head>
<body class="admin-body">
<%- include('partials/sidebar') %>
<main class="admin-main">
  <h1>Yêu cầu thu cũ đổi mới</h1>
  <p class="admin-hint">Danh sách yêu cầu khách gửi từ trang công khai "Thu Cũ Đổi Mới", bao gồm cả "Chỉ thu cũ" và "Thu cũ - Lên đời". Đổi "Trạng thái" để cập nhật tiến độ xử lý; dữ liệu máy/giá được lưu cố định tại thời điểm khách gửi nên vẫn chính xác dù sau này sửa/xóa sản phẩm thu cũ hoặc sản phẩm lên đời liên quan.</p>

  <form action="/admin/thu-cu/yeu-cau" method="get" class="sort-form order-filter-form">
    <label for="status">Trạng thái</label>
    <select id="status" name="status" onchange="this.form.submit()">
      <option value="">Tất cả</option>
      <% statuses.forEach(function(s) { %>
        <option value="<%= s.key %>" <%= statusFilter === s.key ? 'selected' : '' %>><%= s.label %></option>
      <% }); %>
    </select>
    <% if (statusFilter) { %>
      <a href="/admin/thu-cu/yeu-cau" class="btn btn-outline btn-sm">Bỏ lọc</a>
    <% } %>
  </form>

  <% if (requests.length === 0) { %>
    <p class="empty-state">Chưa có yêu cầu nào<%= statusFilter ? ' với trạng thái này.' : '.' %></p>
  <% } else { %>
    <div class="admin-table-scroll">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Mã yêu cầu</th>
            <th>Khách hàng</th>
            <th>Loại</th>
            <th>Máy thu cũ</th>
            <th>Máy lên đời</th>
            <th>Ngày gửi</th>
            <th>Trạng thái</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% requests.forEach(function(r) { %>
            <tr>
              <td><%= r.request_code %></td>
              <td><%= r.customer_name %><br /><small><%= r.phone %></small></td>
              <td><span class="status-badge <%= r.mode === 'len_doi' ? 'status-active' : 'status-inactive' %>"><%= r.mode === 'len_doi' ? 'Thu cũ - Lên đời' : 'Chỉ thu cũ' %></span></td>
              <td>
                <%= r.trade_in_product_name %><br />
                <small><%= r.trade_in_condition_label %> &middot; <%= formatVND(r.trade_in_price) %></small>
              </td>
              <td>
                <% if (r.mode === 'len_doi') { %>
                  <%= r.upgrade_product_name %>
                  <% if (r.upgrade_variant_label || r.upgrade_color_name) { %>
                    <br /><small><%= [r.upgrade_variant_label, r.upgrade_color_name].filter(Boolean).join(' / ') %></small>
                  <% } %>
                  <br /><small>
                    <% if (r.upgrade_price !== null && r.upgrade_price !== undefined) { %>Giá: <%= formatVND(r.upgrade_price) %><% } %>
                    <% if (r.upgrade_subsidy) { %> &middot; Trợ giá: <%= formatVND(r.upgrade_subsidy) %><% } %>
                  </small>
                <% } else { %>
                  -
                <% } %>
              </td>
              <td><%= new Date(r.created_at).toLocaleString('vi-VN') %></td>
              <td>
                <form action="/admin/thu-cu/yeu-cau/<%= r.id %>/trang-thai" method="post" class="status-select-form">
                  <input type="hidden" name="redirectTo" value="/admin/thu-cu/yeu-cau<%= statusFilter ? '?status=' + statusFilter : '' %>" />
                  <select name="status" class="status-select status-<%= r.status %>" onchange="this.className = 'status-select status-' + this.value; this.form.submit()">
                    <% statuses.forEach(function(s) { %>
                      <option value="<%= s.key %>" <%= r.status === s.key ? 'selected' : '' %>><%= s.label %></option>
                    <% }); %>
                  </select>
                </form>
              </td>
              <td class="admin-actions">
                <button
                  type="button"
                  class="btn-link trade-in-detail-btn"
                  data-code="<%= r.request_code %>"
                  data-customer="<%= r.customer_name %>"
                  data-phone="<%= r.phone %>"
                  data-mode="<%= r.mode === 'len_doi' ? 'Thu cũ - Lên đời' : 'Chỉ thu cũ' %>"
                  data-tradein="<%= r.trade_in_product_name %> &middot; <%= r.trade_in_condition_label %> &middot; <%= formatVND(r.trade_in_price) %>"
                  data-upgrade="<% if (r.mode === 'len_doi') { %><%= r.upgrade_product_name %><% if (r.upgrade_variant_label || r.upgrade_color_name) { %> (<%= [r.upgrade_variant_label, r.upgrade_color_name].filter(Boolean).join(' / ') %>)<% } %><% if (r.upgrade_price !== null && r.upgrade_price !== undefined) { %> &middot; <%= formatVND(r.upgrade_price) %><% } %><% if (r.upgrade_subsidy) { %> &middot; Trợ giá <%= formatVND(r.upgrade_subsidy) %><% } %><% } else { %>-<% } %>"
                  data-note="<%= r.note || '-' %>"
                  data-date="<%= new Date(r.created_at).toLocaleString('vi-VN') %>"
                >Chi tiết</button>
                <form action="/admin/thu-cu/yeu-cau/<%= r.id %>/xoa" method="post" onsubmit="return confirm('Xóa yêu cầu &quot;' + <%- JSON.stringify(r.request_code) %> + '&quot;?');">
                  <button type="submit" class="btn-link-danger">Xóa</button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>

  <div class="modal-overlay" id="tradeInDetailModal" hidden>
    <div class="modal-box" role="dialog" aria-modal="true" aria-labelledby="tdCode">
      <button type="button" class="modal-close" id="tradeInDetailClose" aria-label="Đóng">&times;</button>
      <h3 id="tdCode"></h3>
      <p class="modal-field"><strong>Khách hàng:</strong> <span id="tdCustomer"></span></p>
      <p class="modal-field"><strong>Loại:</strong> <span id="tdMode"></span></p>
      <p class="modal-field"><strong>Máy thu cũ:</strong> <span id="tdTradeIn"></span></p>
      <p class="modal-field"><strong>Máy lên đời:</strong> <span id="tdUpgrade"></span></p>
      <p class="modal-field"><strong>Ghi chú:</strong> <span id="tdNote"></span></p>
      <p class="modal-field"><strong>Ngày gửi:</strong> <span id="tdDate"></span></p>
    </div>
  </div>

  <script>
    // Modal "Chi tiết" -- bang danh sach khong co cot Ghi chu (de gon), nut
    // nay hien lai day du thong tin yeu cau bang cach doc data-* tu chinh
    // nut vua bam, khong can goi them API.
    (function () {
      var modal = document.getElementById('tradeInDetailModal');
      if (!modal) return;
      var closeBtn = document.getElementById('tradeInDetailClose');
      var fields = {
        code: document.getElementById('tdCode'),
        customer: document.getElementById('tdCustomer'),
        mode: document.getElementById('tdMode'),
        tradein: document.getElementById('tdTradeIn'),
        upgrade: document.getElementById('tdUpgrade'),
        note: document.getElementById('tdNote'),
        date: document.getElementById('tdDate')
      };

      document.querySelectorAll('.trade-in-detail-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          fields.code.textContent = btn.getAttribute('data-code') || '';
          fields.customer.textContent = (btn.getAttribute('data-customer') || '') + ' - ' + (btn.getAttribute('data-phone') || '');
          fields.mode.textContent = btn.getAttribute('data-mode') || '';
          fields.tradein.textContent = btn.getAttribute('data-tradein') || '-';
          fields.upgrade.textContent = btn.getAttribute('data-upgrade') || '-';
          fields.note.textContent = btn.getAttribute('data-note') || '-';
          fields.date.textContent = btn.getAttribute('data-date') || '-';
          modal.hidden = false;
        });
      });

      closeBtn.addEventListener('click', function () { modal.hidden = true; });
      modal.addEventListener('click', function (e) { if (e.target === modal) modal.hidden = true; });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && !modal.hidden) modal.hidden = true;
      });
    })();
  </script>
</main>
</body>
</html>
