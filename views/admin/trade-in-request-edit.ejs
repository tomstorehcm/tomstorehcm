<!doctype html>
<html lang="vi">
<head>
<%- include('partials/head') %>
</head>
<body class="admin-body">
<%- include('partials/sidebar') %>
<main class="admin-main">
  <div class="admin-title-row">
    <a href="/admin/thu-cu/yeu-cau" class="btn-icon-back" aria-label="Quay lại Khách Trade In" title="Quay lại Khách Trade In">&larr;</a>
    <h1>Sửa yêu cầu <%= request.request_code %></h1>
  </div>
  <p class="admin-hint">Sửa được thông tin khách hàng VÀ thông tin máy (tên máy, tình trạng, giá, IMEI...) -- chỉ "Loại" yêu cầu (chỉ thu cũ / thu cũ lên đời) là giữ cố định, không đổi được ở đây. Mỗi lần lưu sẽ tự ghi vào "Lịch sử chỉnh sửa" bên dưới.</p>

  <% if (errors.length > 0) { %>
    <div class="form-errors"><ul><% errors.forEach(function(e) { %><li><%= e.msg %></li><% }); %></ul></div>
  <% } %>

  <form action="/admin/thu-cu/yeu-cau/<%= request.id %>/sua" method="post" class="admin-form">
    <div class="form-row">
      <div class="form-group">
        <label for="customerName">Tên khách *</label>
        <input type="text" id="customerName" name="customerName" value="<%= request.customer_name || '' %>" required maxlength="150" />
      </div>
      <div class="form-group">
        <label for="phone">Số điện thoại *</label>
        <input type="tel" id="phone" name="phone" value="<%= request.phone || '' %>" placeholder="09xxxxxxxx" required />
      </div>
    </div>
    <div class="form-row">
      <div class="form-group">
        <label for="tradeInImei">IMEI / Serial máy thu cũ (nếu có)</label>
        <input type="text" id="tradeInImei" name="tradeInImei" value="<%= request.trade_in_imei || '' %>" maxlength="50" />
      </div>
      <% if (request.mode === 'len_doi') { %>
        <div class="form-group">
          <label for="upgradeImei">IMEI / Serial máy lên đời (nếu có)</label>
          <input type="text" id="upgradeImei" name="upgradeImei" value="<%= request.upgrade_imei || '' %>" maxlength="50" />
        </div>
      <% } %>
    </div>
    <div class="form-group">
      <label for="note">Ghi chú</label>
      <textarea id="note" name="note" rows="3"><%= request.note || '' %></textarea>
    </div>

    <h2 class="admin-category-heading">Thông tin máy</h2>
    <p class="admin-hint">Loại: <strong><%= request.mode === 'len_doi' ? 'Thu cũ - Lên đời' : 'Chỉ thu cũ' %></strong> (không đổi được loại yêu cầu ở đây).</p>

    <div class="form-row">
      <div class="form-group">
        <label for="tradeInProductName">Máy thu cũ *</label>
        <input type="text" id="tradeInProductName" name="tradeInProductName" value="<%= request.trade_in_product_name || '' %>" required maxlength="200" />
      </div>
      <div class="form-group">
        <label for="tradeInConditionLabel">Tình trạng máy thu cũ *</label>
        <input type="text" id="tradeInConditionLabel" name="tradeInConditionLabel" value="<%= request.trade_in_condition_label || '' %>" required maxlength="150" />
      </div>
    </div>
    <div class="form-group">
      <label for="tradeInPrice">Giá thu cũ (VNĐ) *</label>
      <input type="text" inputmode="numeric" id="tradeInPrice" name="tradeInPrice" class="vnd-input" value="<%= request.trade_in_price || '' %>" required />
    </div>

    <% if (request.mode === 'len_doi') { %>
      <div class="form-row">
        <div class="form-group">
          <label for="upgradeProductName">Máy lên đời</label>
          <input type="text" id="upgradeProductName" name="upgradeProductName" value="<%= request.upgrade_product_name || '' %>" maxlength="200" />
        </div>
        <div class="form-group">
          <label for="upgradeVariantLabel">Dung lượng / phiên bản</label>
          <input type="text" id="upgradeVariantLabel" name="upgradeVariantLabel" value="<%= request.upgrade_variant_label || '' %>" maxlength="100" />
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="upgradeColorName">Màu</label>
          <input type="text" id="upgradeColorName" name="upgradeColorName" value="<%= request.upgrade_color_name || '' %>" maxlength="100" />
        </div>
        <div class="form-group">
          <label for="upgradePrice">Giá máy lên đời (VNĐ)</label>
          <input type="text" inputmode="numeric" id="upgradePrice" name="upgradePrice" class="vnd-input" value="<%= request.upgrade_price || '' %>" />
        </div>
      </div>
      <div class="form-group">
        <label for="upgradeSubsidy">Trợ giá (VNĐ)</label>
        <input type="text" inputmode="numeric" id="upgradeSubsidy" name="upgradeSubsidy" class="vnd-input" value="<%= request.upgrade_subsidy || '' %>" />
      </div>
    <% } %>

    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
    <a href="/admin/thu-cu/yeu-cau" class="btn btn-outline">Hủy</a>
  </form>

  <%- include('partials/edit-history') %>
</main>
</body>
</html>
