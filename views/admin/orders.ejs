<!doctype html>
<html lang="vi">
<head>
<%- include('partials/head') %>
</head>
<body class="admin-body">
<%- include('partials/sidebar') %>
<main class="admin-main">
  <h1>Đơn hàng</h1>

  <table class="admin-table">
    <thead><tr><th>Mã đơn</th><th>Khách hàng</th><th>SĐT</th><th>Thanh toán</th><th>Tổng tiền</th><th>Trạng thái</th><th></th></tr></thead>
    <tbody>
      <% orders.forEach(function(order) { %>
        <tr>
          <td><%= order.order_code %></td>
          <td><%= order.customer_name %></td>
          <td><%= order.phone %></td>
          <td><%= order.payment_method === 'cod' ? 'COD' : 'Chuyển khoản' %></td>
          <td><%= formatVND(order.total) %></td>
          <td><span class="status-badge status-<%= order.status %>"><%= order.status %></span></td>
          <td><a href="/admin/don-hang/<%= order.id %>">Chi tiết</a></td>
        </tr>
      <% }); %>
      <% if (orders.length === 0) { %>
        <tr><td colspan="7">Chưa có đơn hàng nào.</td></tr>
      <% } %>
    </tbody>
  </table>
</main>
</body>
</html>
