<!doctype html>
<html lang="vi">
<head>
<%- include('partials/head') %>
</head>
<body class="admin-body">
<%- include('partials/sidebar') %>
<main class="admin-main">
  <h1>Xác nhận đổi mật khẩu</h1>
  <p class="admin-hint">TOMSTORE đã gửi mã xác nhận 6 số về email admin. Nhập mã đó bên dưới để hoàn tất đổi mật khẩu.</p>

  <% if (error) { %><div class="form-errors"><ul><li><%= error %></li></ul></div><% } %>

  <form action="/admin/doi-mat-khau/xac-nhan" method="post" class="admin-form" id="confirmChangePasswordForm">
    <div class="form-group">
      <label for="code">Mã xác nhận</label>
      <input type="text" id="code" name="code" inputmode="numeric" maxlength="6" required autofocus />
    </div>
    <button type="submit" class="btn btn-primary btn-lg">Xác nhận</button>
  </form>
  <p><a href="/admin/doi-mat-khau">&larr; Quay lại, nhập mật khẩu khác</a></p>
</main>
</body>
</html>
