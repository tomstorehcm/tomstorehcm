<!doctype html>
<html lang="vi">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title><%= title %></title>
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="/css/style.css" />
</head>
<body class="admin-login-body">
  <div class="admin-login-card">
    <div class="logo"><img src="/images/logo/tom-logo.png" alt="TOMSTORE" /></div>
    <p class="admin-login-subtitle">Quên mật khẩu</p>
    <% if (error) { %><div class="form-errors"><ul><li><%= error %></li></ul></div><% } %>
    <% if (success) { %>
      <div class="form-success"><%= success %></div>
    <% } else { %>
      <p class="admin-hint">Nhập email khôi phục đã đăng ký cho tài khoản admin, TOMSTORE sẽ gửi link đặt lại mật khẩu.</p>
      <form action="/admin/quen-mat-khau" method="post">
        <div class="form-group">
          <label for="email">Email khôi phục</label>
          <input type="email" id="email" name="email" required autofocus />
        </div>
        <button type="submit" class="btn btn-primary btn-lg btn-block">Gửi email đặt lại mật khẩu</button>
      </form>
    <% } %>
    <a href="/admin/login" class="admin-login-forgot-link">&larr; Quay lại đăng nhập</a>
  </div>
</body>
</html>
