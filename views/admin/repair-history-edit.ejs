<!doctype html>
<html lang="vi">
<head>
<%- include('partials/head') %>
</head>
<body class="admin-body">
<%- include('partials/sidebar') %>
<main class="admin-main">
  <div class="admin-title-row">
    <a href="/admin/sua-chua/lich-su" class="btn-icon-back" aria-label="Quay lại lịch sử sửa chữa" title="Quay lại lịch sử sửa chữa">&larr;</a>
    <h1>Sửa lịch sử sửa chữa</h1>
  </div>

  <% if (errors.length > 0) { %>
    <div class="form-errors"><ul><% errors.forEach(function(e) { %><li><%= e.msg %></li><% }); %></ul></div>
  <% } %>

  <form action="/admin/sua-chua/lich-su/<%= entry.id %>/sua" method="post" class="admin-form">
    <div class="form-row">
      <div class="form-group">
        <label for="repairDate">Ngày sửa chữa *</label>
        <input type="date" id="repairDate" name="repairDate" value="<%= String(entry.repair_date || '').slice(0, 10) %>" required />
      </div>
      <div class="form-group">
        <label for="cost">Chi phí (nếu có)</label>
        <input type="text" inputmode="numeric" id="cost" name="cost" class="vnd-input" value="<%= entry.cost || '' %>" placeholder="VNĐ" />
      </div>
    </div>
    <div class="form-row">
      <div class="form-group">
        <label for="customerName">Tên khách *</label>
        <input type="text" id="customerName" name="customerName" value="<%= entry.customer_name || '' %>" required maxlength="150" />
      </div>
      <div class="form-group">
        <label for="phone">Số điện thoại *</label>
        <input type="tel" id="phone" name="phone" value="<%= entry.phone || '' %>" placeholder="09xxxxxxxx" required />
      </div>
    </div>
    <div class="form-row">
      <div class="form-group">
        <label for="deviceName">Thiết bị *</label>
        <input type="text" id="deviceName" name="deviceName" value="<%= entry.device_name || '' %>" required maxlength="200" />
      </div>
      <div class="form-group">
        <label for="imei">IMEI / Serial (nếu có)</label>
        <input type="text" id="imei" name="imei" value="<%= entry.imei || '' %>" maxlength="50" />
      </div>
    </div>
    <div class="form-group">
      <label for="issue">Nội dung sửa chữa / Tình trạng *</label>
      <textarea id="issue" name="issue" rows="2" required><%= entry.issue || '' %></textarea>
    </div>
    <div class="form-group">
      <label for="resolution">Đã xử lý</label>
      <textarea id="resolution" name="resolution" rows="2"><%= entry.resolution || '' %></textarea>
    </div>
    <div class="form-group">
      <label for="note">Ghi chú</label>
      <textarea id="note" name="note" rows="2"><%= entry.note || '' %></textarea>
    </div>
    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
    <a href="/admin/sua-chua/lich-su" class="btn btn-outline">Hủy</a>
  </form>
</main>
</body>
</html>
