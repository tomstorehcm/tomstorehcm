<button type="button" class="admin-menu-toggle" id="adminMenuToggle" aria-label="Mở menu" aria-expanded="false">
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
  Menu
</button>
<aside class="admin-sidebar">
  <div class="admin-sidebar-head">
    <div class="logo admin-logo"><img src="/images/logo/tom-logo.png" alt="TOMSTORE" /></div>
    <button type="button" class="admin-sidebar-close" id="adminSidebarClose" aria-label="Đóng menu">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    </button>
  </div>
  <nav class="admin-nav">
    <a href="/admin" class="<%= currentPath === '/admin' || currentPath.startsWith('/admin/don-hang') ? 'active' : '' %>">Quản lý đơn hàng</a>
    <a href="/admin/san-pham" class="<%= currentPath.startsWith('/admin/san-pham') ? 'active' : '' %>">Sản phẩm</a>
    <a href="/admin/hot-deal" class="<%= currentPath.startsWith('/admin/hot-deal') ? 'active' : '' %>">Best Deal</a>
    <a href="/admin/khach-hang" class="<%= currentPath.startsWith('/admin/khach-hang') ? 'active' : '' %>">Khách mua hàng</a>
    <a href="/admin/banner" class="<%= currentPath.startsWith('/admin/banner') ? 'active' : '' %>">Banner trang chủ</a>
    <a href="/admin/chinh-sach" class="<%= currentPath.startsWith('/admin/chinh-sach') ? 'active' : '' %>">Chính sách</a>
    <a href="/admin/bao-hanh" class="<%= currentPath.startsWith('/admin/bao-hanh') ? 'active' : '' %>">Chính sách bảo hành (trang)</a>
    <div class="admin-nav-group">
      <span class="admin-nav-group-label">Trade In</span>
      <a href="/admin/thu-cu" class="<%= currentPath === '/admin/thu-cu' || currentPath.startsWith('/admin/thu-cu/moi') || (currentPath.startsWith('/admin/thu-cu/') && currentPath.endsWith('/sua') && !currentPath.startsWith('/admin/thu-cu/yeu-cau')) ? 'active' : '' %>">Sản phẩm thu cũ (Trade-in)</a>
      <a href="/admin/thu-cu/san-pham-len-doi" class="<%= currentPath.startsWith('/admin/thu-cu/san-pham-len-doi') ? 'active' : '' %>">Sản phẩm Trade In</a>
      <a href="/admin/thu-cu/yeu-cau" class="<%= currentPath.startsWith('/admin/thu-cu/yeu-cau') ? 'active' : '' %>">Khách Trade In</a>
      <a href="/admin/thu-cu/gioi-thieu" class="<%= currentPath.startsWith('/admin/thu-cu/gioi-thieu') ? 'active' : '' %>">Giới thiệu (trang)</a>
    </div>
    <div class="admin-nav-group">
      <span class="admin-nav-group-label">REPAIRING</span>
      <a href="/admin/sua-chua" class="<%= currentPath === '/admin/sua-chua' || currentPath.startsWith('/admin/sua-chua/moi') || (currentPath.startsWith('/admin/sua-chua/') && currentPath.endsWith('/sua') && !currentPath.startsWith('/admin/sua-chua/lich-su') && !currentPath.startsWith('/admin/sua-chua/san-pham') && !currentPath.startsWith('/admin/sua-chua/yeu-cau')) ? 'active' : '' %>">Dịch vụ sửa chữa</a>
      <a href="/admin/sua-chua/san-pham" class="<%= currentPath.startsWith('/admin/sua-chua/san-pham') ? 'active' : '' %>">Sản phẩm (dòng máy)</a>
      <a href="/admin/sua-chua/yeu-cau" class="<%= currentPath.startsWith('/admin/sua-chua/yeu-cau') ? 'active' : '' %>">Khách sửa chữa</a>
      <a href="/admin/sua-chua/lich-su" class="<%= currentPath.startsWith('/admin/sua-chua/lich-su') ? 'active' : '' %>">Lịch sử sửa chữa</a>
    </div>
    <a href="/admin/tra-gop" class="<%= currentPath.startsWith('/admin/tra-gop') ? 'active' : '' %>">Trả góp linh động</a>
    <a href="/admin/doi-mat-khau" class="<%= currentPath === '/admin/doi-mat-khau' ? 'active' : '' %>">Đổi mật khẩu</a>
    <a href="/" target="_blank">Xem website &rarr;</a>
  </nav>
  <form action="/admin/logout" method="post" class="admin-logout-form" onsubmit="return confirm('Bạn có chắc muốn đăng xuất?');">
    <button type="submit" class="btn btn-logout btn-block">Đăng xuất</button>
  </form>
</aside>
<div class="admin-sidebar-backdrop" id="adminSidebarBackdrop"></div>
