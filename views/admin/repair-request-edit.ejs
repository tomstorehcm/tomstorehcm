<!doctype html>
<html lang="vi">
<head>
<%- include('partials/head') %>
</head>
<body class="admin-body">
<%- include('partials/sidebar') %>
<main class="admin-main">
  <div class="admin-title-row">
    <a href="/admin/sua-chua/yeu-cau" class="btn-icon-back" aria-label="Quay lại Khách sửa chữa" title="Quay lại Khách sửa chữa">&larr;</a>
    <h1>Sửa yêu cầu <%= request.request_code %></h1>
  </div>
  <p class="admin-hint">Chỉ sửa được thông tin khách hàng (tên, số điện thoại, IMEI, ghi chú) -- dịch vụ/loại/giá đã chọn được giữ cố định tại thời điểm khách gửi nên không sửa ở đây. Mỗi lần lưu sẽ tự ghi vào "Lịch sử chỉnh sửa" bên dưới.</p>

  <% if (errors.length > 0) { %>
    <div class="form-errors"><ul><% errors.forEach(function(e) { %><li><%= e.msg %></li><% }); %></ul></div>
  <% } %>

  <form action="/admin/sua-chua/yeu-cau/<%= request.id %>/sua" method="post" class="admin-form">
    <div class="form-row">
      <div class="form-group">
        <label for="customerName">Tên khách *</label>
        <input type="text" id="customerName" name="customerName" value="<%= request.customer_name || '' %>" required maxlength="150" />
      </div>
      <div class="form-group">
        <label for="phone">Số điện thoại *</label>
        <input type="tel" id="phone" name="phone" value="<%= request.phone || '' %>" placeholder="09xxxxxxxx" required />
      </div>
    </div>
    <div class="form-group">
      <label for="imei">IMEI / Serial (nếu có)</label>
      <input type="text" id="imei" name="imei" value="<%= request.imei || '' %>" maxlength="50" />
    </div>
    <div class="form-group">
      <label for="note">Ghi chú</label>
      <textarea id="note" name="note" rows="3"><%= request.note || '' %></textarea>
    </div>
    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
    <a href="/admin/sua-chua/yeu-cau" class="btn btn-outline">Hủy</a>
  </form>

  <h2 class="admin-category-heading">Dịch vụ đã chọn (cố định, không sửa được)</h2>
  <% if (items.length === 0) { %>
    <p class="empty-state">Không có mục nào.</p>
  <% } else { %>
    <div class="admin-table-scroll">
      <table class="admin-table">
        <thead><tr><th>Dịch vụ</th><th>Sản phẩm</th><th>Loại</th><th>Giá</th></tr></thead>
        <tbody>
          <% items.forEach(function(it) { %>
            <tr>
              <td><%= it.service_name %></td>
              <td><%= it.device_name %></td>
              <td><%= it.variant_label %></td>
              <td><%= formatVND(it.price) %></td>
            </tr>
          <% }); %>
        </tbody>
        <tfoot>
          <tr><td colspan="3">Tổng giá</td><td><%= formatVND(request.total_price) %></td></tr>
        </tfoot>
      </table>
    </div>
  <% } %>

  <%- include('partials/edit-history') %>
</main>
</body>
</html>
