<!doctype html>
<html lang="vi">
<head>
<%- include('partials/head') %>
</head>
<body class="admin-body">
<%- include('partials/sidebar') %>
<main class="admin-main">
  <h1>Sửa thông tin khách hàng</h1>

  <% if (errors.length > 0) { %>
    <div class="form-errors"><ul><% errors.forEach(function(e) { %><li><%= e.msg %></li><% }); %></ul></div>
  <% } %>

  <form action="/admin/khach-hang/<%= customer.id %>/sua" method="post" class="admin-form">
    <div class="form-row">
      <div class="form-group">
        <label for="name">Họ tên *</label>
        <input type="text" id="name" name="name" value="<%= customer.name || '' %>" required maxlength="150" />
      </div>
      <div class="form-group">
        <label for="phone">Số điện thoại *</label>
        <input type="text" id="phone" name="phone" value="<%= customer.phone || '' %>" required />
      </div>
    </div>
    <div class="form-group">
      <label for="address">Địa chỉ</label>
      <input type="text" id="address" name="address" value="<%= customer.address || '' %>" />
    </div>
    <div class="form-group">
      <label for="note">Ghi chú</label>
      <textarea id="note" name="note" rows="3"><%= customer.note || '' %></textarea>
    </div>
    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
    <a href="/admin/khach-hang/<%= customer.id %>" class="btn btn-outline">Hủy</a>
  </form>
</main>
</body>
</html>
