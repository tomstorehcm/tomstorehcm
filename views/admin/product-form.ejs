<!doctype html>
<html lang="vi">
<head>
<%- include('partials/head') %>
</head>
<body class="admin-body">
<%- include('partials/sidebar') %>
<main class="admin-main">
  <h1><%= isEdit ? 'Sửa sản phẩm' : 'Thêm sản phẩm' %></h1>

  <% if (errors.length > 0) { %>
    <div class="form-errors"><ul><% errors.forEach(function(e) { %><li><%= e.msg %></li><% }); %></ul></div>
  <% } %>

  <form action="<%= isEdit ? '/admin/san-pham/' + product.id + '/sua' : '/admin/san-pham/moi' %>" method="post" class="admin-form" enctype="multipart/form-data">
    <div class="form-group">
      <label for="name">Tên sản phẩm *</label>
      <input type="text" id="name" name="name" value="<%= product.name || '' %>" required />
    </div>
    <div class="form-group">
      <label for="categoryId">Danh mục *</label>
      <select id="categoryId" name="categoryId" required>
        <% categories.forEach(function(c) { %>
          <option value="<%= c.id %>" <%= Number(product.category_id) === c.id ? 'selected' : '' %>><%= c.name %></option>
        <% }); %>
      </select>
    </div>
    <div class="form-group">
      <label for="brand">Thương hiệu</label>
      <input type="text" id="brand" name="brand" value="<%= product.brand || '' %>" />
    </div>
    <div class="form-row">
      <div class="form-group">
        <label for="price">Giá gốc (VND) *</label>
        <input type="number" id="price" name="price" min="0" value="<%= product.price || '' %>" required />
      </div>
      <div class="form-group">
        <label for="salePrice">Giá khuyến mãi (VND)</label>
        <input type="number" id="salePrice" name="salePrice" min="0" value="<%= product.sale_price || '' %>" />
      </div>
      <div class="form-group">
        <label for="stock">Tồn kho *</label>
        <input type="number" id="stock" name="stock" min="0" value="<%= typeof product.stock !== 'undefined' ? product.stock : 0 %>" required />
      </div>
    </div>
    <div class="form-group">
      <label for="imageFile">Ảnh đại diện (hiển thị ở danh sách/giỏ hàng)</label>
      <% if (product.image_url) { %>
        <img src="<%= product.image_url %>" alt="" class="admin-image-preview" />
      <% } %>
      <input type="file" id="imageFile" name="imageFile" accept="image/png,image/jpeg,image/gif" />
      <small>Chọn ảnh để tải lên trực tiếp. Bỏ trống nếu muốn giữ ảnh hiện tại hoặc nhập URL bên dưới.</small>
    </div>
    <div class="form-group">
      <label for="imageUrl">Hoặc dán URL hình ảnh</label>
      <input type="text" id="imageUrl" name="imageUrl" value="<%= product.image_url && product.image_url.startsWith('/images/uploads/') ? '' : (product.image_url || '') %>" placeholder="https://..." />
      <small>Để trống tất cả sẽ dùng icon minh họa theo danh mục.</small>
    </div>
    <div class="form-group form-group-checkbox">
      <label class="checkbox-option">
        <input type="checkbox" name="isFeatured" <%= product.is_featured ? 'checked' : '' %> />
        Hiển thị trong mục "Sản phẩm Hot" ở trang chủ
      </label>
    </div>
    <div class="form-group">
      <label for="description">Mô tả</label>
      <textarea id="description" name="description" rows="3"><%= product.description || '' %></textarea>
    </div>
    <div class="form-group">
      <label for="specsText">Thông số kỹ thuật</label>
      <textarea id="specsText" name="specsText" rows="6" placeholder="Màn hình: 6.7 inch OLED&#10;Chip: Apple A17 Pro"><%= specsText %></textarea>
      <small>Mỗi dòng một thông số, định dạng "Tên: Giá trị".</small>
    </div>
    <button type="submit" class="btn btn-primary btn-lg"><%= isEdit ? 'Lưu thay đổi' : 'Thêm sản phẩm' %></button>
  </form>

  <% if (isEdit) { %>
    <section class="admin-form gallery-section">
      <h2>Ảnh chi tiết sản phẩm (tối đa 8 ảnh)</h2>
      <p class="admin-hint">Hiển thị trên trang chi tiết sản phẩm dưới dạng nhiều ảnh, khách bấm vào ảnh nhỏ để xem ảnh lớn. Ảnh đại diện ở trên luôn là ảnh đầu tiên.</p>

      <% if (galleryImages.length > 0) { %>
        <div class="gallery-manage-grid">
          <% galleryImages.forEach(function(img) { %>
            <div class="gallery-manage-item">
              <img src="<%= img.image_url %>" alt="" />
              <form action="/admin/san-pham/<%= product.id %>/anh/<%= img.id %>/xoa" method="post" onsubmit="return confirm('Xóa ảnh này?');">
                <button type="submit" class="btn-remove">&times;</button>
              </form>
            </div>
          <% }); %>
        </div>
      <% } %>

      <% if (galleryImages.length < 8) { %>
        <form action="/admin/san-pham/<%= product.id %>/anh" method="post" enctype="multipart/form-data" class="gallery-upload-form">
          <input type="file" name="images" accept="image/png,image/jpeg,image/gif" multiple required />
          <small>Còn có thể thêm tối đa <%= 8 - galleryImages.length %> ảnh nữa. Ảnh sẽ tự crop về kích thước 1000 × 1000px.</small>
          <button type="submit" class="btn btn-outline">Tải ảnh lên</button>
        </form>
      <% } else { %>
        <p class="empty-state">Đã đạt tối đa 8 ảnh. Xóa bớt ảnh cũ để thêm ảnh mới.</p>
      <% } %>
    </section>
  <% } %>
</main>
</body>
</html>
