<!doctype html>
<html lang="vi">
<head>
<%- include('partials/head') %>
</head>
<body class="admin-body">
<%- include('partials/sidebar') %>
<main class="admin-main">
  <h1><%= isEdit ? 'Sửa sản phẩm' : 'Thêm sản phẩm' %></h1>

  <% if (errors.length > 0) { %>
    <div class="form-errors"><ul><% errors.forEach(function(e) { %><li><%= e.msg %></li><% }); %></ul></div>
  <% } %>

  <%
    var PRESET_COLORS = [
      { hex: '#1d1d1f', name: 'Đen' },
      { hex: '#2b2b2d', name: 'Xám Đậm' },
      { hex: '#4b4b4d', name: 'Xám' },
      { hex: '#e3e4e5', name: 'Bạc' },
      { hex: '#f5f5f0', name: 'Trắng' },
      { hex: '#8f8a81', name: 'Titan Tự Nhiên' },
      { hex: '#3c4a5c', name: 'Titan Xanh' },
      { hex: '#cbb994', name: 'Titan Sa Mạc' },
      { hex: '#f0e2d0', name: 'Vàng' },
      { hex: '#f4c8bc', name: 'Vàng Hồng' },
      { hex: '#e8d44d', name: 'Vàng Chanh' },
      { hex: '#e8622c', name: 'Cam' },
      { hex: '#a41e22', name: 'Đỏ' },
      { hex: '#f0c6ce', name: 'Hồng' },
      { hex: '#5f4b6e', name: 'Tím' },
      { hex: '#4b3c5e', name: 'Tím Đậm' },
      { hex: '#3f5a75', name: 'Xanh Dương' },
      { hex: '#2d2d6b', name: 'Xanh Navy' },
      { hex: '#1c4966', name: 'Xanh Biển' },
      { hex: '#4c5c48', name: 'Xanh Lá' },
      { hex: '#2f6b5e', name: 'Xanh Ngọc' },
      { hex: '#a8d8b9', name: 'Xanh Bạc Hà' },
      { hex: '#d9cbb3', name: 'Be' },
      { hex: '#6b4423', name: 'Nâu' }
    ];
  %>
  <div class="product-edit-layout">
  <form id="productForm" action="<%= isEdit ? '/admin/san-pham/' + product.id + '/sua' : '/admin/san-pham/moi' %>" method="post" class="admin-form" enctype="multipart/form-data">
    <div class="form-group">
      <label for="name">Tên sản phẩm *</label>
      <input type="text" id="name" name="name" value="<%= product.name || '' %>" required />
    </div>
    <div class="form-group">
      <label for="categoryId">Danh mục *</label>
      <select id="categoryId" name="categoryId" required>
        <% categories.forEach(function(c) { %>
          <option value="<%= c.id %>" <%= Number(product.category_id) === c.id ? 'selected' : '' %>><%= c.name %></option>
        <% }); %>
      </select>
    </div>
    <div class="form-group">
      <label for="brand">Thương hiệu</label>
      <input type="text" id="brand" name="brand" value="<%= product.brand || '' %>" />
    </div>
    <div class="form-group form-group-checkbox">
      <label class="checkbox-option">
        <input type="checkbox" id="isContactPrice" name="isContactPrice" <%= product.is_contact_price ? 'checked' : '' %> />
        Giá liên hệ (ẩn giá, khách bấm "Liên hệ" thay vì "Thêm vào giỏ")
      </label>
    </div>
    <div class="form-row">
      <div class="form-group" id="priceGroup">
        <label for="price">Giá gốc (VND) <span id="priceRequiredMark">*</span></label>
        <input type="text" inputmode="numeric" class="price-input" id="price" name="price" value="<%= product.price || '' %>" <%= product.is_contact_price ? '' : 'required' %> />
      </div>
      <div class="form-group" id="salePriceGroup">
        <label for="salePrice">Giá khuyến mãi (VND)</label>
        <input type="text" inputmode="numeric" class="price-input" id="salePrice" name="salePrice" value="<%= product.sale_price || '' %>" />
      </div>
      <div class="form-group form-group-checkbox">
        <label class="checkbox-option">
          <input type="checkbox" id="outOfStock" name="outOfStock" <%= (typeof product.in_stock !== 'undefined' && !product.in_stock) ? 'checked' : '' %> />
          Hết hàng toàn bộ
        </label>
        <small>Đánh dấu ô này để ẩn mua toàn bộ sản phẩm, kể cả khi từng dung lượng bên dưới vẫn đang để "Còn hàng".</small>
      </div>
    </div>
    <% if (!isEdit) { %>
      <div class="form-group">
        <label for="imageFile">Ảnh đại diện</label>
        <input type="file" id="imageFile" name="imageFile" accept="image/png,image/jpeg,image/gif,image/webp,.heic,.heif" />
        <small>Bỏ trống nếu muốn dùng icon minh họa theo danh mục.</small>
      </div>
      <div class="form-group">
        <label>Ảnh chi tiết (tối đa 8 ảnh)</label>
        <label for="galleryFileInput" class="btn btn-outline gallery-pick-btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          Chọn ảnh chi tiết
        </label>
        <input type="file" id="galleryFileInput" name="images" accept="image/png,image/jpeg,image/gif,image/webp,.heic,.heif" multiple hidden />
        <small>Ảnh sẽ tự crop về kích thước 1000 × 1000px.</small>
        <ul class="gallery-staged-list" id="galleryStagedList"></ul>
      </div>
    <% } %>
    <div class="form-group form-group-checkbox">
      <label class="checkbox-option">
        <input type="checkbox" name="isFeatured" <%= product.is_featured ? 'checked' : '' %> />
        Hiển thị trong mục "Sản phẩm Hot" ở trang chủ
      </label>
    </div>
    <div class="form-group">
      <label for="description">Mô tả</label>
      <textarea id="description" name="description" rows="3"><%= product.description || '' %></textarea>
    </div>
    <div class="form-group">
      <label for="specsText">Thông số kỹ thuật</label>
      <textarea id="specsText" name="specsText" rows="6" placeholder="Màn hình: 6.7 inch OLED&#10;Chip: Apple A17 Pro"><%= specsText %></textarea>
      <small>Mỗi dòng một thông số, định dạng "Tên: Giá trị".</small>
    </div>
    <%
      function colorRowInStock(c) {
        return typeof c.in_stock !== 'undefined' ? !!c.in_stock : (typeof c.inStock !== 'undefined' ? !!c.inStock : true);
      }
      function colorRowHex(c) {
        return c.hex_code || c.hex || PRESET_COLORS[0].hex;
      }
      function colorsForVariant(allColors, variant, variantIndex) {
        return (allColors || []).filter(function(c) {
          if (typeof variant.id !== 'undefined') return c.variant_id === variant.id;
          return c.variantIndex === variantIndex;
        });
      }
      function generalColors(allColors) {
        return (allColors || []).filter(function(c) {
          if (typeof c.variant_id !== 'undefined') return !c.variant_id;
          return c.variantIndex === null || typeof c.variantIndex === 'undefined';
        });
      }
      function variantsForGroup(allVariants, group, groupIndex) {
        return (allVariants || []).filter(function(v) {
          if (typeof group.id !== 'undefined') return v.variant_group_id === group.id;
          return v.groupIndex === groupIndex;
        });
      }
      function ungroupedVariants(allVariants) {
        return (allVariants || []).filter(function(v) {
          if (typeof v.variant_group_id !== 'undefined') return !v.variant_group_id;
          return v.groupIndex === null || typeof v.groupIndex === 'undefined';
        });
      }
    %>
    <div class="form-group">
      <label for="variantGroupLabel">Tên nhóm lớn (tùy chọn)</label>
      <input type="text" id="variantGroupLabel" name="variantGroupLabel" value="<%= product.variant_group_label || '' %>" placeholder="VD: Kích thước màn hình, Loại kết nối" />
      <small>Dùng khi sản phẩm cần chia theo 1 nhóm lớn trước cả dung lượng (VD: MacBook chia theo kích thước màn hình 13/14/16 inch, iPad chia theo loại kết nối WiFi/WiFi+5G), mỗi nhóm có dung lượng và màu riêng của nó. Để trống nếu sản phẩm chỉ cần chọn dung lượng/màu bình thường, không cần nhóm lớn.</small>
    </div>
    <div class="form-group" id="groupedVariantsSection" hidden>
      <label>Dung lượng / phiên bản theo từng nhóm lớn</label>
      <div id="groupRows" class="group-rows">
        <% (variantGroups || []).forEach(function(g, gi) { %>
          <div class="group-row-group">
            <div class="group-row">
              <input type="text" name="groupName" placeholder="VD: 13 inch" value="<%= g.name %>" />
              <button type="button" class="btn-remove group-remove-btn" aria-label="Xóa nhóm">&times;</button>
            </div>
            <div class="group-variants">
              <div class="group-variants-rows">
                <% variantsForGroup(variants, g, gi).forEach(function(v) { %>
                  <%- include('partials/variant-row-group', { v: v, variants: variants, colors: colors, PRESET_COLORS: PRESET_COLORS, colorRowInStock: colorRowInStock, colorRowHex: colorRowHex, colorsForVariant: colorsForVariant }) %>
                <% }); %>
              </div>
              <button type="button" class="btn btn-outline btn-sm add-group-variant-btn">+ Thêm dung lượng cho nhóm này</button>
            </div>
          </div>
        <% }); %>
      </div>
      <button type="button" id="addGroupRowBtn" class="btn btn-outline btn-sm">+ Thêm nhóm lớn</button>
    </div>
    <div class="form-group" id="flatVariantsSection">
      <label>Dung lượng / phiên bản (tùy chọn)</label>
      <div id="variantRows" class="variant-rows">
        <% ungroupedVariants(variants).forEach(function(v) { %>
          <%- include('partials/variant-row-group', { v: v, variants: variants, colors: colors, PRESET_COLORS: PRESET_COLORS, colorRowInStock: colorRowInStock, colorRowHex: colorRowHex, colorsForVariant: colorsForVariant }) %>
        <% }); %>
      </div>
      <button type="button" id="addVariantRowBtn" class="btn btn-outline btn-sm">+ Thêm dung lượng</button>
      <small>Bỏ trống nếu sản phẩm không có nhiều lựa chọn dung lượng. Khi có ít nhất 1 dòng, trang sản phẩm sẽ hiện nút chọn dung lượng và dùng giá/trạng thái riêng của từng dòng thay cho giá gốc phía trên. Mỗi dung lượng có thể có các màu riêng với giá riêng — để trống giá màu để dùng giá của dung lượng.</small>
    </div>
    <div class="form-group">
      <label>Màu sắc chung (không theo dung lượng)</label>
      <div id="colorRows" class="color-rows">
        <% generalColors(colors).forEach(function(c) { %>
          <%- include('partials/color-row-group', { c: c, withPrice: false, PRESET_COLORS: PRESET_COLORS, colorRowInStock: colorRowInStock, colorRowHex: colorRowHex }) %>
        <% }); %>
      </div>
      <button type="button" id="addColorRowBtn" class="btn btn-outline btn-sm">+ Thêm màu sắc</button>
      <small>Dùng mục này khi sản phẩm không có dung lượng nhưng vẫn có nhiều màu để chọn. Màu ở đây không ảnh hưởng đến giá.</small>
    </div>
    <div class="form-group">
      <label for="policyGroupId">Nhóm chính sách bảo hành</label>
      <select id="policyGroupId" name="policyGroupId">
        <option value="">— Chọn riêng từng mục bên dưới —</option>
        <% policyGroups.forEach(function(g) { %>
          <option value="<%= g.id %>" <%= Number(product.policy_group_id) === g.id ? 'selected' : '' %>><%= g.name %><%= g.is_default ? ' (mặc định)' : '' %></option>
        <% }); %>
      </select>
      <small>Chọn 1 nhóm để dùng toàn bộ chính sách trong nhóm đó. Để trống nếu muốn chọn riêng từng mục bên dưới. Quản lý các mục này ở trang <a href="/admin/chinh-sach" target="_blank">Chính sách</a>.</small>
    </div>
    <div class="form-group" id="individualPoliciesGroup">
      <label>Hoặc chọn riêng từng chính sách</label>
      <% if (allPolicies.length === 0) { %>
        <small>Chưa có chính sách nào. Vào trang <a href="/admin/chinh-sach" target="_blank">Chính sách</a> để thêm.</small>
      <% } else { %>
        <div class="policy-checkbox-list">
          <% allPolicies.forEach(function(p) { %>
            <label class="checkbox-option policy-checkbox-option">
              <input type="checkbox" name="policyIds" value="<%= p.id %>" <%= selectedPolicyIds.includes(p.id) ? 'checked' : '' %> />
              <%= p.title %>
            </label>
          <% }); %>
        </div>
      <% } %>
    </div>
    <button type="submit" class="btn btn-primary btn-lg"><%= isEdit ? 'Lưu thay đổi' : 'Thêm sản phẩm' %></button>
  </form>

  <% if (isEdit) { %>
    <section class="admin-form gallery-section image-management-col">
      <h2>Ảnh sản phẩm</h2>
      <p class="admin-hint">Chọn/đổi ảnh đại diện và ảnh chi tiết bên dưới, rồi bấm "Lưu ảnh" để tải lên toàn bộ cùng một lúc.</p>

      <form action="/admin/san-pham/<%= product.id %>/anh" method="post" enctype="multipart/form-data" id="imageUploadForm">
        <div class="form-group">
          <label>Ảnh đại diện</label>
          <img src="<%= product.image_url || '' %>" alt="" class="admin-image-preview" id="mainImagePreviewImg" <%= product.image_url ? '' : 'hidden' %> />
          <label for="mainImageInput" class="btn btn-outline gallery-pick-btn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            Chọn ảnh đại diện
          </label>
          <input type="file" id="mainImageInput" name="imageFile" accept="image/png,image/jpeg,image/gif,image/webp,.heic,.heif" hidden />
          <input type="text" id="imageUrlInput" name="imageUrl" value="<%= product.image_url && product.image_url.startsWith('/images/uploads/') ? '' : (product.image_url || '') %>" placeholder="Hoặc dán URL ảnh..." />
          <% if (product.image_url) { %>
            <button type="submit" name="removeImage" value="1" class="btn btn-outline gallery-delete-main-btn" formnovalidate onclick="return confirm('Xóa ảnh đại diện hiện tại?');">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
              Xóa ảnh đại diện
            </button>
          <% } %>
          <small>Chọn ảnh mới sẽ thay ảnh hiện tại. Bỏ trống cả hai để giữ nguyên.</small>
        </div>

        <div class="form-group">
          <label>Ảnh chi tiết (tối đa 8 ảnh)</label>
          <% if (galleryImages.length > 0) { %>
            <div class="gallery-manage-grid">
              <% galleryImages.forEach(function(img) { %>
                <div class="gallery-manage-item">
                  <img src="<%= img.image_url %>" alt="" />
                  <button type="button" class="btn-remove gallery-delete-btn" data-delete-url="/admin/san-pham/<%= product.id %>/anh/<%= img.id %>/xoa">&times;</button>
                </div>
              <% }); %>
            </div>
          <% } %>

          <% if (galleryImages.length < 8) { %>
            <label for="galleryFileInput" class="btn btn-outline gallery-pick-btn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
              Chọn ảnh chi tiết
            </label>
            <input type="file" id="galleryFileInput" name="images" accept="image/png,image/jpeg,image/gif,image/webp,.heic,.heif" multiple hidden />
            <small>Còn có thể thêm tối đa <%= 8 - galleryImages.length %> ảnh nữa. Ảnh sẽ tự crop về kích thước 1000 × 1000px.</small>
            <ul class="gallery-staged-list" id="galleryStagedList"></ul>
          <% } else { %>
            <p class="empty-state">Đã đạt tối đa 8 ảnh. Xóa bớt ảnh cũ để thêm ảnh mới.</p>
          <% } %>
        </div>

        <button type="submit" class="btn btn-primary">Lưu ảnh</button>
      </form>
    </section>
  <% } %>
  </div>
</main>
<form id="galleryDeleteForm" method="post" hidden></form>
<script>
  (function () {
    var checkbox = document.getElementById('isContactPrice');
    var priceInput = document.getElementById('price');
    var requiredMark = document.getElementById('priceRequiredMark');
    var salePriceInput = document.getElementById('salePrice');

    function sync() {
      var isContact = checkbox.checked;
      priceInput.required = !isContact;
      requiredMark.style.display = isContact ? 'none' : '';
      salePriceInput.disabled = isContact;
      if (isContact) salePriceInput.value = '';
    }

    checkbox.addEventListener('change', sync);
    sync();

    // Chọn nhóm chính sách -> làm mờ (không bắt buộc chọn) danh sách chọn riêng từng mục
    var policyGroupSelect = document.getElementById('policyGroupId');
    var individualPoliciesGroup = document.getElementById('individualPoliciesGroup');
    if (policyGroupSelect && individualPoliciesGroup) {
      function syncPolicyMode() {
        var groupChosen = !!policyGroupSelect.value;
        individualPoliciesGroup.classList.toggle('is-disabled', groupChosen);
        individualPoliciesGroup.querySelectorAll('input[type=checkbox]').forEach(function (cb) {
          cb.disabled = groupChosen;
        });
      }
      policyGroupSelect.addEventListener('change', syncPolicyMode);
      syncPolicyMode();
    }

    // Format price inputs with "." as thousand separator while typing
    function digitsOnly(str) {
      return (str || '').replace(/\D/g, '');
    }
    function formatWithDots(str) {
      var digits = digitsOnly(str);
      return digits.replace(/\B(?=(\d{3})+(?!\d))/g, '.');
    }

    function formatPriceInput(input) {
      input.value = formatWithDots(input.value);
    }

    document.querySelectorAll('.price-input').forEach(formatPriceInput);

    var productForm = document.getElementById('productForm');
    productForm.addEventListener('input', function (e) {
      if (!e.target.classList.contains('price-input')) return;
      var input = e.target;
      var cursorFromEnd = input.value.length - input.selectionStart;
      input.value = formatWithDots(input.value);
      var pos = input.value.length - cursorFromEnd;
      input.setSelectionRange(pos, pos);
    });
    productForm.addEventListener('submit', function () {
      productForm.querySelectorAll('.price-input').forEach(function (input) {
        input.value = digitsOnly(input.value);
      });
    });

    // Màu sắc: bảng màu định sẵn + tạo dòng màu mới (dùng chung cho cả màu
    // riêng theo dung lượng và màu chung không theo dung lượng)
    var PRESET_COLORS = [
      ['#1d1d1f', 'Đen'], ['#2b2b2d', 'Xám Đậm'], ['#4b4b4d', 'Xám'], ['#e3e4e5', 'Bạc'],
      ['#f5f5f0', 'Trắng'], ['#8f8a81', 'Titan Tự Nhiên'], ['#3c4a5c', 'Titan Xanh'], ['#cbb994', 'Titan Sa Mạc'],
      ['#f0e2d0', 'Vàng'], ['#f4c8bc', 'Vàng Hồng'], ['#e8d44d', 'Vàng Chanh'], ['#e8622c', 'Cam'],
      ['#a41e22', 'Đỏ'], ['#f0c6ce', 'Hồng'], ['#5f4b6e', 'Tím'], ['#4b3c5e', 'Tím Đậm'],
      ['#3f5a75', 'Xanh Dương'], ['#2d2d6b', 'Xanh Navy'], ['#1c4966', 'Xanh Biển'], ['#4c5c48', 'Xanh Lá'],
      ['#2f6b5e', 'Xanh Ngọc'], ['#a8d8b9', 'Xanh Bạc Hà'], ['#d9cbb3', 'Be'], ['#6b4423', 'Nâu']
    ];

    function buildColorRowGroup(withPrice) {
      var swatchButtons = PRESET_COLORS.map(function (p) {
        return '<button type="button" class="color-swatch-option" data-hex="' + p[0] + '" style="background-color: ' + p[0] + ';" title="' + p[1] + '"></button>';
      }).join('');
      var placeholderIcon = '<svg class="color-image-placeholder-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3" stroke="currentColor" stroke-width="1.6"/><circle cx="9" cy="10" r="1.6" fill="currentColor"/><path d="M21 15l-5.5-5.5a2 2 0 0 0-2.8 0L4 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>';
      var group = document.createElement('div');
      group.className = 'color-row-group';
      group.innerHTML =
        '<div class="color-row' + (withPrice ? ' color-row-priced' : '') + '">' +
        '<label class="color-image-picker" title="Chọn ảnh cho màu này">' +
        '<img class="color-image-preview" alt="" hidden />' +
        placeholderIcon +
        '<input type="file" class="color-image-input" accept="image/png,image/jpeg,image/gif,image/webp,.heic,.heif" hidden />' +
        '</label>' +
        '<input type="hidden" name="colorImageUrl" class="color-image-url-input" value="" />' +
        '<details class="color-swatch-picker">' +
        '<summary class="color-hex-swatch" style="background-color: ' + PRESET_COLORS[0][0] + ';"></summary>' +
        '<div class="color-swatch-grid">' + swatchButtons + '</div>' +
        '</details>' +
        '<input type="hidden" name="colorHex" class="color-hex-input" value="' + PRESET_COLORS[0][0] + '" />' +
        '<input type="text" name="colorName" placeholder="VD: Titan Xanh" />' +
        (withPrice ? '<input type="text" inputmode="numeric" class="price-input color-price-input" name="colorPrice" placeholder="Giá riêng (để trống = dùng giá dung lượng)" />' : '') +
        '<select name="colorInStock"><option value="1" selected>Còn hàng</option><option value="0">Hết hàng</option></select>' +
        '<input type="hidden" name="colorVariantIndex" class="color-variant-index-input" value="" />' +
        '<button type="button" class="btn-remove color-remove-btn" aria-label="Xóa dòng">&times;</button>' +
        '</div>';
      return group;
    }

    function buildVariantRowGroup() {
      var group = document.createElement('div');
      group.className = 'variant-row-group';
      group.innerHTML =
        '<div class="variant-row">' +
        '<input type="text" name="variantLabel" placeholder="VD: 256GB" />' +
        '<input type="text" inputmode="numeric" class="price-input variant-price-input" name="variantPrice" placeholder="Giá (VND)" />' +
        '<select name="variantInStock"><option value="1" selected>Còn hàng</option><option value="0">Hết hàng</option></select>' +
        '<input type="hidden" name="variantGroupIndex" class="variant-group-index-input" value="" />' +
        '<button type="button" class="btn-remove variant-remove-btn" aria-label="Xóa dòng">&times;</button>' +
        '</div>' +
        '<div class="variant-colors">' +
        '<div class="variant-colors-rows"></div>' +
        '<button type="button" class="btn btn-outline btn-sm add-variant-color-btn">+ Thêm màu cho dung lượng này</button>' +
        '</div>';
      return group;
    }

    function buildGroupRowGroup() {
      var group = document.createElement('div');
      group.className = 'group-row-group';
      group.innerHTML =
        '<div class="group-row">' +
        '<input type="text" name="groupName" placeholder="VD: 13 inch" />' +
        '<button type="button" class="btn-remove group-remove-btn" aria-label="Xóa nhóm">&times;</button>' +
        '</div>' +
        '<div class="group-variants">' +
        '<div class="group-variants-rows"></div>' +
        '<button type="button" class="btn btn-outline btn-sm add-group-variant-btn">+ Thêm dung lượng cho nhóm này</button>' +
        '</div>';
      return group;
    }

    // Sự kiện cho mọi dòng màu/dung lượng/nhóm, dù nằm phẳng hay lồng nhiều
    // cấp (nhóm > dung lượng > màu) -- gắn 1 lần trên toàn form thay vì lặp
    // lại theo từng nơi chứa, vì các dòng có thể được thêm động ở bất kỳ cấp nào.
    productForm.addEventListener('click', function (e) {
      if (e.target.classList.contains('color-remove-btn')) {
        e.target.closest('.color-row-group').remove();
        return;
      }
      if (e.target.classList.contains('variant-remove-btn')) {
        e.target.closest('.variant-row-group').remove();
        return;
      }
      if (e.target.classList.contains('group-remove-btn')) {
        e.target.closest('.group-row-group').remove();
        return;
      }
      if (e.target.classList.contains('add-variant-color-btn')) {
        var colorRowsContainer = e.target.closest('.variant-colors').querySelector('.variant-colors-rows');
        colorRowsContainer.appendChild(buildColorRowGroup(true));
        return;
      }
      if (e.target.classList.contains('add-group-variant-btn')) {
        var variantRowsContainer = e.target.closest('.group-variants').querySelector('.group-variants-rows');
        variantRowsContainer.appendChild(buildVariantRowGroup());
        return;
      }
      if (e.target.classList.contains('color-swatch-option')) {
        var picker = e.target.closest('.color-swatch-picker');
        var hex = e.target.getAttribute('data-hex');
        picker.closest('.color-row').querySelector('.color-hex-input').value = hex;
        picker.querySelector('summary').style.backgroundColor = hex;
        picker.querySelectorAll('.color-swatch-option').forEach(function (btn) {
          btn.classList.toggle('active', btn === e.target);
        });
        picker.open = false;
      }
    });
    productForm.addEventListener('change', function (e) {
      if (!e.target.classList.contains('color-image-input')) return;
      var file = e.target.files && e.target.files[0];
      if (!file) return;
      var row = e.target.closest('.color-row');
      var preview = row.querySelector('.color-image-preview');
      var placeholder = row.querySelector('.color-image-placeholder-icon');
      preview.src = URL.createObjectURL(file);
      preview.hidden = false;
      if (placeholder) placeholder.hidden = true;
    });

    // Dung lượng / phiên bản (chế độ phẳng, không nhóm): thêm dòng động
    var variantRows = document.getElementById('variantRows');
    var addVariantRowBtn = document.getElementById('addVariantRowBtn');
    if (variantRows && addVariantRowBtn) {
      addVariantRowBtn.addEventListener('click', function () {
        variantRows.appendChild(buildVariantRowGroup());
      });
    }

    // Nhóm lớn: thêm dòng nhóm động, mỗi nhóm có khu dung lượng riêng lồng bên trong
    var groupRows = document.getElementById('groupRows');
    var addGroupRowBtn = document.getElementById('addGroupRowBtn');
    if (groupRows && addGroupRowBtn) {
      addGroupRowBtn.addEventListener('click', function () {
        groupRows.appendChild(buildGroupRowGroup());
      });
    }

    // Bật/tắt chế độ nhóm lớn theo việc admin có gõ "Tên nhóm lớn" hay không --
    // để trống thì dùng khu dung lượng phẳng như trước, gõ tên thì chuyển sang
    // khu nhóm lớn (mỗi nhóm có dung lượng + màu riêng bên trong).
    var variantGroupLabelInput = document.getElementById('variantGroupLabel');
    var groupedVariantsSection = document.getElementById('groupedVariantsSection');
    var flatVariantsSection = document.getElementById('flatVariantsSection');
    function usingVariantGroups() {
      return !!(variantGroupLabelInput && variantGroupLabelInput.value.trim());
    }
    function syncVariantMode() {
      var useGroups = usingVariantGroups();
      if (groupedVariantsSection) groupedVariantsSection.hidden = !useGroups;
      if (flatVariantsSection) flatVariantsSection.hidden = useGroups;
    }
    if (variantGroupLabelInput && groupedVariantsSection && flatVariantsSection) {
      variantGroupLabelInput.addEventListener('input', syncVariantMode);
      syncVariantMode();
    }

    // Màu sắc chung (không theo dung lượng): thêm dòng động
    var colorRows = document.getElementById('colorRows');
    var addColorRowBtn = document.getElementById('addColorRowBtn');
    if (colorRows && addColorRowBtn) {
      addColorRowBtn.addEventListener('click', function () {
        colorRows.appendChild(buildColorRowGroup(false));
      });
    }

    // Truoc khi luu: gan lai colorVariantIndex theo vi tri dong dung luong hien
    // tai trong toan bo trang (ke ca dung luong nam long trong 1 nhom lon), gan
    // lai variantGroupIndex theo vi tri dong nhom lon chua dung luong do (rong
    // neu dung luong khong nam trong nhom nao), danh lai ten file anh theo mau
    // (colorImage_0, colorImage_1, ...) dung vi tri hien tai trong toan bo danh
    // sach, va vo hieu hoa (disable) toan bo khu dung luong dang an de khong
    // gui len server 2 bo du lieu dung luong cung luc (chi khu dang hien mac
    // dinh -- phang hay theo nhom -- moi thuc su duoc luu).
    productForm.addEventListener('submit', function () {
      var allGroupRowGroups = document.querySelectorAll('.group-row-group');
      document.querySelectorAll('.variant-row-group').forEach(function (group, groupIndex) {
        group.querySelectorAll('.color-variant-index-input').forEach(function (input) {
          input.value = groupIndex;
        });
        var groupIndexInput = group.querySelector('.variant-group-index-input');
        if (groupIndexInput) {
          var parentGroup = group.closest('.group-row-group');
          groupIndexInput.value = parentGroup ? Array.prototype.indexOf.call(allGroupRowGroups, parentGroup) : '';
        }
      });
      document.querySelectorAll('.color-row').forEach(function (row, i) {
        var fileInput = row.querySelector('.color-image-input');
        if (fileInput && fileInput.files && fileInput.files[0]) {
          fileInput.name = 'colorImage_' + i;
        }
      });
      var inactiveSection = usingVariantGroups() ? flatVariantsSection : groupedVariantsSection;
      if (inactiveSection) {
        inactiveSection.querySelectorAll('input, select, textarea').forEach(function (el) {
          el.disabled = true;
        });
      }
    });

    // Ảnh đại diện: xem trước ngay khi chọn file
    var mainImageInput = document.getElementById('mainImageInput');
    if (mainImageInput) {
      var mainPreviewImg = document.getElementById('mainImagePreviewImg');
      mainImageInput.addEventListener('change', function () {
        if (mainImageInput.files && mainImageInput.files[0]) {
          mainPreviewImg.src = URL.createObjectURL(mainImageInput.files[0]);
          mainPreviewImg.hidden = false;
        }
      });
    }

    // Ảnh chi tiết: chọn nhiều ảnh -> hiện danh sách xem trước -> "Lưu ảnh" upload tất cả cùng lúc
    var galleryInput = document.getElementById('galleryFileInput');
    if (galleryInput) {
      var stagedList = document.getElementById('galleryStagedList');
      var stagedFiles = [];

      function syncInputFiles() {
        var dt = new DataTransfer();
        stagedFiles.forEach(function (file) { dt.items.add(file); });
        galleryInput.files = dt.files;
      }

      function renderStagedList() {
        stagedList.innerHTML = '';
        stagedFiles.forEach(function (file, index) {
          var li = document.createElement('li');
          li.className = 'gallery-staged-item';

          var thumb = document.createElement('img');
          thumb.src = URL.createObjectURL(file);
          li.appendChild(thumb);

          var name = document.createElement('span');
          name.className = 'gallery-staged-name';
          name.textContent = file.name;
          li.appendChild(name);

          var removeBtn = document.createElement('button');
          removeBtn.type = 'button';
          removeBtn.className = 'btn-remove';
          removeBtn.innerHTML = '&times;';
          removeBtn.addEventListener('click', function () {
            stagedFiles.splice(index, 1);
            syncInputFiles();
            renderStagedList();
          });
          li.appendChild(removeBtn);

          stagedList.appendChild(li);
        });
      }

      galleryInput.addEventListener('change', function () {
        Array.prototype.forEach.call(galleryInput.files, function (file) {
          stagedFiles.push(file);
        });
        syncInputFiles();
        renderStagedList();
      });
    }

    // Xóa 1 ảnh chi tiết đã lưu (form riêng, tách khỏi form Lưu chính)
    var deleteForm = document.getElementById('galleryDeleteForm');
    document.querySelectorAll('.gallery-delete-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        if (!confirm('Xóa ảnh này?')) return;
        deleteForm.action = btn.getAttribute('data-delete-url');
        deleteForm.submit();
      });
    });
  })();
</script>
</body>
</html>
