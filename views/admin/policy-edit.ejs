<!doctype html>
<html lang="vi">
<head>
<%- include('partials/head') %>
</head>
<body class="admin-body">
<%- include('partials/sidebar') %>
<main class="admin-main">
  <a href="/admin/chinh-sach" class="back-link">&larr; Quay lại danh sách chính sách</a>
  <h1>Sửa chính sách</h1>

  <form action="/admin/chinh-sach/<%= policy.id %>/sua" method="post" class="admin-form">
    <div class="form-group">
      <label for="title">Tiêu đề *</label>
      <input type="text" id="title" name="title" value="<%= policy.title %>" required />
    </div>
    <div class="form-group">
      <label for="description">Mô tả</label>
      <input type="text" id="description" name="description" value="<%= policy.description || '' %>" />
    </div>
    <div class="form-group">
      <label for="icon">Icon</label>
      <select id="icon" name="icon">
        <% Object.keys(iconLabels).forEach(function(key) { %>
          <option value="<%= key %>" <%= policy.icon === key ? 'selected' : '' %>><%= iconLabels[key] %></option>
        <% }); %>
      </select>
    </div>
    <div class="form-group">
      <label for="groupId">Nhóm</label>
      <select id="groupId" name="groupId">
        <option value="">Không thuộc nhóm nào</option>
        <% groups.forEach(function(g) { %>
          <option value="<%= g.id %>" <%= policy.group_id === g.id ? 'selected' : '' %>><%= g.name %></option>
        <% }); %>
      </select>
    </div>
    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
  </form>
</main>
</body>
</html>
