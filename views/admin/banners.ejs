<!doctype html>
<html lang="vi">
<head>
<%- include('partials/head') %>
</head>
<body class="admin-body">
<%- include('partials/sidebar') %>
<main class="admin-main">
  <h1>Quản lý Banner</h1>
  <p class="admin-hint">Mỗi loại banner có kích thước cố định — ảnh bạn tải lên (dù to/nhỏ/sai tỉ lệ) sẽ <strong>tự động được crop vừa khít</strong> kích thước đó, không cần chỉnh sửa trước. Chỉ nhận file JPG/PNG/GIF/WEBP.</p>

  <% if (error) { %><div class="form-errors"><ul><li><%= error %></li></ul></div><% } %>

  <!-- Banner chính -->
  <section class="banner-section">
    <h2>1. Banner chính (đầu trang chủ)</h2>
    <p class="admin-hint">Ảnh desktop (ngang) cố định <strong>1800 × 700px</strong>. Ảnh mobile (dọc, không bắt buộc) cố định <strong>1080 × 1350px</strong> — nếu bỏ trống, mobile sẽ tạm dùng ảnh desktop crop vào giữa (có thể mất chữ 2 bên), nên khuyến nghị luôn thêm ảnh mobile riêng. Nhiều banner sẽ tự động chạy luân phiên.</p>

    <form action="/admin/banner/chinh" method="post" enctype="multipart/form-data" class="admin-form banner-upload-form">
      <div class="form-row">
        <div class="form-group">
          <label for="heroImage">Ảnh desktop (ngang) *</label>
          <img class="admin-image-preview" id="heroImagePreview" hidden />
          <input type="file" id="heroImage" name="image" accept="image/png,image/jpeg,image/gif,image/webp" data-preview="heroImagePreview" required />
        </div>
        <div class="form-group">
          <label for="heroImageMobile">Ảnh mobile (dọc)</label>
          <img class="admin-image-preview" id="heroImageMobilePreview" hidden />
          <input type="file" id="heroImageMobile" name="imageMobile" accept="image/png,image/jpeg,image/gif,image/webp" data-preview="heroImageMobilePreview" />
        </div>
      </div>
      <div class="form-group">
        <label for="heroLinkUrl">Link khi bấm vào banner (không bắt buộc)</label>
        <input type="text" id="heroLinkUrl" name="linkUrl" placeholder="/danh-muc/dien-thoai" />
      </div>
      <button type="submit" class="btn btn-primary">+ Thêm banner chính</button>
    </form>

    <table class="admin-table">
      <thead><tr><th>Ảnh desktop</th><th>Ảnh mobile</th><th>Link</th><th>Thứ tự</th><th>Trạng thái</th><th>Thao tác</th></tr></thead>
      <tbody>
        <% heroBanners.forEach(function(b) { %>
          <tr>
            <td><img src="<%= b.image_url %>" alt="Banner chính" class="admin-banner-thumb" /></td>
            <td>
              <% if (b.image_url_mobile) { %>
                <img src="<%= b.image_url_mobile %>" alt="Banner mobile" class="admin-banner-thumb-mobile" />
              <% } else { %>
                <span class="status-badge status-inactive">Chưa có</span>
              <% } %>
              <form action="/admin/banner/chinh/<%= b.id %>/anh-mobile" method="post" enctype="multipart/form-data" class="banner-mobile-form">
                <input type="file" accept="image/png,image/jpeg,image/gif,image/webp" required />
                <button type="submit" class="btn btn-outline btn-sm"><%= b.image_url_mobile ? 'Đổi ảnh mobile' : '+ Thêm ảnh mobile' %></button>
              </form>
            </td>
            <td><%= b.link_url || '-' %></td>
            <td>
              <form action="/admin/banner/chinh/<%= b.id %>/thu-tu" method="post" class="inline-number-form">
                <input type="number" name="sortOrder" value="<%= b.sort_order %>" min="0" />
                <button type="submit" class="btn btn-outline btn-sm">Lưu</button>
              </form>
            </td>
            <td><span class="status-badge <%= b.is_active ? 'status-active' : 'status-inactive' %>"><%= b.is_active ? 'Đang hiện' : 'Đang ẩn' %></span></td>
            <td class="admin-actions">
              <form action="/admin/banner/chinh/<%= b.id %>/an-hien" method="post"><button type="submit" class="btn btn-outline btn-sm"><%= b.is_active ? 'Ẩn' : 'Hiện' %></button></form>
              <form action="/admin/banner/chinh/<%= b.id %>/xoa" method="post" onsubmit="return confirm('Xóa banner này?');"><button type="submit" class="btn-link-danger">Xóa</button></form>
            </td>
          </tr>
        <% }); %>
        <% if (heroBanners.length === 0) { %>
          <tr><td colspan="6">Chưa có banner chính nào.</td></tr>
        <% } %>
      </tbody>
    </table>
  </section>

  <!-- Banner Sản phẩm Hot -->
  <section class="banner-section">
    <h2>2. Banner khối "Sản phẩm Hot"</h2>
    <p class="admin-hint">Kích thước cố định: <strong>480 × 840px</strong>. Chỉ 1 ảnh — tải ảnh mới sẽ thay thế ảnh cũ.</p>

    <div class="featured-banner-preview">
      <% if (featuredBanner) { %>
        <img src="<%= featuredBanner.image_url %>" alt="Banner Sản phẩm Hot" class="admin-featured-thumb" />
      <% } else { %>
        <p class="empty-state">Chưa có banner.</p>
      <% } %>
    </div>

    <form action="/admin/banner/san-pham-hot" method="post" enctype="multipart/form-data" class="admin-form banner-upload-form">
      <div class="form-group">
        <label for="featuredImage">Chọn ảnh mới *</label>
        <img class="admin-image-preview" id="featuredImagePreview" hidden />
        <input type="file" id="featuredImage" name="image" accept="image/png,image/jpeg,image/gif,image/webp" data-preview="featuredImagePreview" required />
      </div>
      <div class="form-group">
        <label for="featuredLinkUrl">Link khi bấm vào banner (không bắt buộc)</label>
        <input type="text" id="featuredLinkUrl" name="linkUrl" value="<%= featuredBanner ? (featuredBanner.link_url || '') : '' %>" placeholder="tel:0769696970" />
      </div>
      <button type="submit" class="btn btn-primary">Cập nhật banner</button>
    </form>
  </section>

  <!-- Ảnh thumb danh mục -->
  <section class="banner-section">
    <h2>3. Ảnh thumb danh mục (trang chủ)</h2>
    <p class="admin-hint">Kích thước cố định: <strong>640 × 640px</strong> (vuông). Mỗi danh mục 1 ảnh đại diện.</p>

    <div class="category-thumb-grid">
      <% categories.forEach(function(cat) { %>
        <div class="category-thumb-card">
          <img src="<%= cat.image_url %>" alt="<%= cat.name %>" class="admin-thumb-preview" id="catThumbPreview<%= cat.id %>" />
          <p><%= cat.name %></p>
          <form action="/admin/banner/danh-muc/<%= cat.id %>" method="post" enctype="multipart/form-data">
            <input type="file" name="image" accept="image/png,image/jpeg,image/gif,image/webp" data-preview="catThumbPreview<%= cat.id %>" required />
            <button type="submit" class="btn btn-outline btn-sm">Đổi ảnh</button>
          </form>
        </div>
      <% }); %>
    </div>
  </section>
</main>
<script>
  (function () {
    document.querySelectorAll('input[type=file][data-preview]').forEach(function (input) {
      input.addEventListener('change', function () {
        var target = document.getElementById(input.getAttribute('data-preview'));
        if (target && input.files && input.files[0]) {
          target.src = URL.createObjectURL(input.files[0]);
          target.hidden = false;
        }
      });
    });
  })();
</script>
</body>
</html>
