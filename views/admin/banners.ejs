<!doctype html>
<html lang="vi">
<head>
<%- include('partials/head') %>
</head>
<body class="admin-body">
<%- include('partials/sidebar') %>
<main class="admin-main">
  <h1>Quản lý Banner</h1>
  <p class="admin-hint">Mỗi loại banner có kích thước cố định — ảnh bạn tải lên (dù to/nhỏ/sai tỉ lệ) sẽ <strong>tự động được crop vừa khít</strong> kích thước đó, không cần chỉnh sửa trước. Chỉ nhận file JPG/PNG/GIF/WEBP.</p>

  <% if (error) { %><div class="form-errors"><ul><li><%= error %></li></ul></div><% } %>

  <!-- Banner chính -->
  <section class="banner-section">
    <h2>1. Banner chính (đầu trang chủ)</h2>
    <p class="admin-hint">Ảnh desktop (ngang) cố định <strong>1800 × 700px</strong>, ảnh mobile (dọc) cố định <strong>1080 × 1350px</strong> — chỉ cần chọn <strong>1 trong 2 ảnh</strong> là thêm được banner (không bắt buộc phải có cả hai). Nếu chỉ có 1 ảnh, ảnh còn lại sẽ tạm dùng chung ảnh đó crop vào giữa (có thể mất chữ 2 bên), nên khuyến nghị thêm đủ cả 2 khi có thể. Nhiều banner sẽ tự động chạy luân phiên.</p>

    <form action="/admin/banner/chinh" method="post" enctype="multipart/form-data" class="admin-form banner-upload-form" id="heroBannerCreateForm">
      <div class="form-row">
        <div class="form-group">
          <label for="heroImage">Ảnh desktop (ngang)</label>
          <img class="admin-image-preview" id="heroImagePreview" hidden />
          <input type="file" id="heroImage" name="image" accept="image/png,image/jpeg,image/gif,image/webp,.heic,.heif" data-preview="heroImagePreview" />
        </div>
        <div class="form-group">
          <label for="heroImageMobile">Ảnh mobile (dọc)</label>
          <img class="admin-image-preview" id="heroImageMobilePreview" hidden />
          <input type="file" id="heroImageMobile" name="imageMobile" accept="image/png,image/jpeg,image/gif,image/webp,.heic,.heif" data-preview="heroImageMobilePreview" />
        </div>
      </div>
      <div class="form-errors" id="heroBannerCreateError" hidden><ul><li>Vui lòng chọn ít nhất 1 ảnh (desktop hoặc mobile).</li></ul></div>
      <div class="form-group">
        <label for="heroLinkUrl">Link khi bấm vào banner (không bắt buộc)</label>
        <input type="text" id="heroLinkUrl" name="linkUrl" placeholder="/danh-muc/dien-thoai" />
      </div>
      <button type="submit" class="btn btn-primary">+ Thêm banner chính</button>
    </form>

    <form id="heroBannersBulkForm" action="/admin/banner/chinh/luu-hang-loat" method="post"></form>
    <table class="admin-table">
      <thead><tr><th>Ảnh desktop</th><th>Ảnh mobile</th><th>Link</th><th>Thứ tự</th><th>Trạng thái</th><th>Thao tác</th></tr></thead>
      <tbody>
        <% heroBanners.forEach(function(b) { %>
          <tr>
            <td>
              <img src="<%= b.image_url || '' %>" alt="Banner chính" class="admin-banner-thumb" id="heroDesktopThumb<%= b.id %>" <%= b.image_url ? '' : 'hidden' %> />
              <span class="status-badge status-inactive" id="heroDesktopBadge<%= b.id %>" <%= b.image_url ? 'hidden' : '' %>>Chưa có</span>
              <form action="/admin/banner/chinh/<%= b.id %>/anh" method="post" enctype="multipart/form-data" class="banner-image-form">
                <label for="heroDesktopFile<%= b.id %>" class="btn btn-outline btn-sm gallery-pick-btn"><%= b.image_url ? 'Đổi ảnh desktop' : '+ Thêm ảnh desktop' %></label>
                <input type="file" id="heroDesktopFile<%= b.id %>" name="image" accept="image/png,image/jpeg,image/gif,image/webp,.heic,.heif" data-preview="heroDesktopThumb<%= b.id %>" data-preview-badge="heroDesktopBadge<%= b.id %>" hidden />
              </form>
              <% if (b.image_url) { %>
                <form action="/admin/banner/chinh/<%= b.id %>/anh/xoa" method="post" class="banner-remove-image-form" onsubmit="return confirm('Xoá ảnh desktop của banner này? (banner sẽ chỉ còn ảnh mobile)');">
                  <button type="submit" class="btn-link-danger">Xoá ảnh desktop</button>
                </form>
              <% } %>
            </td>
            <td>
              <img src="<%= b.image_url_mobile || '' %>" alt="Banner mobile" class="admin-banner-thumb-mobile" id="heroMobileThumb<%= b.id %>" <%= b.image_url_mobile ? '' : 'hidden' %> />
              <span class="status-badge status-inactive" id="heroMobileBadge<%= b.id %>" <%= b.image_url_mobile ? 'hidden' : '' %>>Chưa có</span>
              <form action="/admin/banner/chinh/<%= b.id %>/anh-mobile" method="post" enctype="multipart/form-data" class="banner-image-form">
                <label for="heroMobileFile<%= b.id %>" class="btn btn-outline btn-sm gallery-pick-btn"><%= b.image_url_mobile ? 'Đổi ảnh mobile' : '+ Thêm ảnh mobile' %></label>
                <input type="file" id="heroMobileFile<%= b.id %>" name="image" accept="image/png,image/jpeg,image/gif,image/webp,.heic,.heif" data-preview="heroMobileThumb<%= b.id %>" data-preview-badge="heroMobileBadge<%= b.id %>" hidden />
              </form>
              <% if (b.image_url_mobile) { %>
                <form action="/admin/banner/chinh/<%= b.id %>/anh-mobile/xoa" method="post" class="banner-remove-image-form" onsubmit="return confirm('Xoá ảnh mobile của banner này? (banner sẽ chỉ còn ảnh desktop)');">
                  <button type="submit" class="btn-link-danger">Xoá ảnh mobile</button>
                </form>
              <% } %>
            </td>
            <td>
              <input type="text" name="linkUrl_<%= b.id %>" value="<%= b.link_url || '' %>" placeholder="/danh-muc/dien-thoai" form="heroBannersBulkForm" class="inline-text-input" />
            </td>
            <td>
              <input type="number" name="sortOrder_<%= b.id %>" value="<%= b.sort_order %>" min="0" form="heroBannersBulkForm" class="inline-number-input" />
            </td>
            <td><span class="status-badge <%= b.is_active ? 'status-active' : 'status-inactive' %>"><%= b.is_active ? 'Đang hiện' : 'Đang ẩn' %></span></td>
            <td class="admin-actions admin-actions-center">
              <form action="/admin/banner/chinh/<%= b.id %>/an-hien" method="post"><button type="submit" class="btn btn-outline btn-sm"><%= b.is_active ? 'Ẩn' : 'Hiện' %></button></form>
              <form action="/admin/banner/chinh/<%= b.id %>/xoa" method="post" onsubmit="return confirm('Xóa banner này?');"><button type="submit" class="btn-link-danger">Xóa</button></form>
            </td>
          </tr>
        <% }); %>
        <% if (heroBanners.length === 0) { %>
          <tr><td colspan="6">Chưa có banner chính nào.</td></tr>
        <% } %>
      </tbody>
    </table>
    <% if (heroBanners.length > 0) { %>
      <button type="submit" form="heroBannersBulkForm" class="btn btn-primary hero-bulk-save-btn">Lưu</button>
    <% } %>
  </section>

  <!-- Banner Sản phẩm Hot -->
  <section class="banner-section">
    <h2>2. Banner khối "Sản phẩm Hot"</h2>
    <p class="admin-hint">Kích thước cố định: <strong>480 × 840px</strong>. Ảnh và link chỉnh <strong>riêng nhau</strong> — đổi link không cần chọn lại ảnh, đổi ảnh không cần nhập lại link.</p>

    <div class="featured-banner-preview">
      <% if (featuredBanner) { %>
        <img src="<%= featuredBanner.image_url %>" alt="Banner Sản phẩm Hot" class="admin-featured-thumb" />
      <% } else { %>
        <p class="empty-state">Chưa có banner.</p>
      <% } %>
    </div>

    <form action="/admin/banner/san-pham-hot" method="post" enctype="multipart/form-data" class="admin-form banner-upload-form">
      <div class="form-group">
        <label for="featuredImage">Chọn ảnh mới *</label>
        <img class="admin-image-preview" id="featuredImagePreview" hidden />
        <input type="file" id="featuredImage" name="image" accept="image/png,image/jpeg,image/gif,image/webp,.heic,.heif" data-preview="featuredImagePreview" required />
      </div>
      <button type="submit" class="btn btn-primary"><%= featuredBanner ? 'Đổi ảnh' : 'Tải ảnh lên' %></button>
    </form>

    <% if (featuredBanner) { %>
      <form action="/admin/banner/san-pham-hot/link" method="post" class="admin-form featured-link-form">
        <div class="form-group">
          <label for="featuredLinkUrl">Link khi bấm vào banner (không bắt buộc)</label>
          <input type="text" id="featuredLinkUrl" name="linkUrl" value="<%= featuredBanner.link_url || '' %>" placeholder="tel:0769696970" />
        </div>
        <button type="submit" class="btn btn-outline">Lưu link</button>
      </form>
    <% } %>
  </section>

  <!-- Ảnh thumb danh mục -->
  <section class="banner-section">
    <h2>3. Ảnh thumb danh mục (trang chủ)</h2>
    <p class="admin-hint">Kích thước cố định: <strong>640 × 640px</strong> (vuông). Mỗi danh mục 1 ảnh đại diện. Tên tối đa <strong>24 ký tự</strong> để không bị vỡ giao diện. Nếu hiển thị trang chủ trên 4 danh mục, trang khách sẽ tự chuyển thành khung lướt ngang có mũi tên.</p>

    <div class="category-thumb-grid">
      <% categories.forEach(function(cat) { %>
        <div class="category-thumb-card">
          <span class="status-badge <%= cat.show_on_homepage ? 'status-active' : 'status-inactive' %>"><%= cat.show_on_homepage ? 'Đang hiện' : 'Đang ẩn' %></span>
          <img src="<%= cat.image_url %>" alt="<%= cat.name %>" class="admin-thumb-preview" id="catThumbPreview<%= cat.id %>" />
          <form action="/admin/banner/danh-muc/<%= cat.id %>/ten" method="post" class="category-name-form">
            <input type="text" name="name" value="<%= cat.name %>" maxlength="24" placeholder="Tên danh mục" required />
            <input type="text" name="navLabel" value="<%= cat.nav_label || '' %>" maxlength="30" placeholder="Nhãn menu (tùy chọn, để trống dùng tên)" />
            <button type="submit" class="btn btn-outline btn-sm">Lưu tên</button>
          </form>
          <form action="/admin/banner/danh-muc/<%= cat.id %>" method="post" enctype="multipart/form-data">
            <input type="file" name="image" accept="image/png,image/jpeg,image/gif,image/webp,.heic,.heif" data-preview="catThumbPreview<%= cat.id %>" required />
            <button type="submit" class="btn btn-outline btn-sm">Đổi ảnh</button>
          </form>
          <form action="/admin/banner/danh-muc/<%= cat.id %>/hien-thi" method="post">
            <button type="submit" class="btn btn-outline btn-sm"><%= cat.show_on_homepage ? 'Ẩn khỏi trang chủ' : 'Hiện trên trang chủ' %></button>
          </form>
        </div>
      <% }); %>
    </div>
  </section>
</main>
<script>
  (function () {
    document.querySelectorAll('input[type=file][data-preview]').forEach(function (input) {
      input.addEventListener('change', function () {
        var target = document.getElementById(input.getAttribute('data-preview'));
        if (target && input.files && input.files[0]) {
          target.src = URL.createObjectURL(input.files[0]);
          target.hidden = false;
        }
        var badgeId = input.getAttribute('data-preview-badge');
        var badge = badgeId ? document.getElementById(badgeId) : null;
        if (badge) badge.hidden = true;

        // Rows where "choose file" is the only control (desktop/mobile banner
        // image swap) submit as soon as a file is picked, instead of needing
        // a separate button.
        var form = input.closest('form.banner-image-form');
        if (form && input.files && input.files[0]) form.requestSubmit();
      });
    });

    // "Thêm banner chính": desktop and mobile images are each optional, but
    // at least one of the two must be chosen before submitting.
    var createForm = document.getElementById('heroBannerCreateForm');
    if (createForm) {
      createForm.addEventListener('submit', function (e) {
        var desktopInput = document.getElementById('heroImage');
        var mobileInput = document.getElementById('heroImageMobile');
        var hasDesktop = desktopInput && desktopInput.files && desktopInput.files[0];
        var hasMobile = mobileInput && mobileInput.files && mobileInput.files[0];
        var errorBox = document.getElementById('heroBannerCreateError');
        if (!hasDesktop && !hasMobile) {
          e.preventDefault();
          if (errorBox) errorBox.hidden = false;
        } else if (errorBox) {
          errorBox.hidden = true;
        }
      });
    }
  })();
</script>
</body>
</html>
