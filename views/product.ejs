<!doctype html>
<html lang="vi">
<head>
<%- include('partials/head') %>
</head>
<body>
<%- include('partials/header') %>

<main>
  <div class="container page-container">
    <nav class="breadcrumb">
      <a href="/">Trang chủ</a> / <a href="/danh-muc/<%= category.slug %>"><%= category.name %></a> / <span><%= product.name %></span>
    </nav>

    <div class="product-detail">
      <div class="product-gallery">
        <%
          // Several colors (e.g. the same White across different capacities)
          // often share the exact same photo -- group them into one slide so
          // the gallery doesn't repeat the same picture, while still letting
          // every one of those colors jump to it (data-color-ids, plural).
          var colorImageGroups = [];
          var colorImagesByUrl = {};
          (colors || []).forEach(function(c) {
            if (!c.image_url) return;
            if (!colorImagesByUrl[c.image_url]) {
              colorImagesByUrl[c.image_url] = { image_url: c.image_url, name: c.name, colorIds: [] };
              colorImageGroups.push(colorImagesByUrl[c.image_url]);
            }
            colorImagesByUrl[c.image_url].colorIds.push(c.id);
          });
          var totalSlides = images.length + colorImageGroups.length;
        %>
        <div class="product-gallery-main" id="galleryMain">
          <% if (totalSlides > 0) { %>
            <div class="gallery-track" id="galleryTrack">
              <% images.forEach(function(src, i) { %>
                <div class="gallery-slide">
                  <img src="<%= src %>" alt="<%= product.name %> - ảnh <%= i + 1 %>" width="800" height="800" />
                </div>
              <% }); %>
              <% colorImageGroups.forEach(function(c) { %>
                <div class="gallery-slide" data-color-ids="<%= c.colorIds.join(',') %>">
                  <img src="<%= c.image_url %>" alt="<%= product.name %> - màu <%= c.name %>" width="800" height="800" />
                </div>
              <% }); %>
            </div>
            <% if (totalSlides > 1) { %>
              <button type="button" class="hero-slider-arrow prev" id="galleryPrev" aria-label="Ảnh trước">&larr;</button>
              <button type="button" class="hero-slider-arrow next" id="galleryNext" aria-label="Ảnh sau">&rarr;</button>
            <% } %>
          <% } else { %>
            <span class="product-icon-placeholder product-icon-placeholder-lg"><%- categoryIcon(category.slug) %></span>
          <% } %>
        </div>
        <% if (totalSlides > 1) { %>
          <div class="product-gallery-thumbs">
            <% images.forEach(function(src, i) { %>
              <button type="button" class="gallery-thumb <%= i === 0 ? 'active' : '' %>" data-index="<%= i %>">
                <img src="<%= src %>" alt="<%= product.name %> - ảnh <%= i + 1 %>" width="64" height="64" loading="lazy" />
              </button>
            <% }); %>
            <% colorImageGroups.forEach(function(c, j) { %>
              <button type="button" class="gallery-thumb" data-index="<%= images.length + j %>" data-color-ids="<%= c.colorIds.join(',') %>">
                <img src="<%= c.image_url %>" alt="<%= product.name %> - màu <%= c.name %>" width="64" height="64" loading="lazy" />
              </button>
            <% }); %>
          </div>
        <% } %>
      </div>

      <div class="product-detail-info">
        <% if (product.brand) { %><span class="product-brand"><%= product.brand %></span><% } %>
        <h1><%= product.name %></h1>

        <%
          var hasGroups = variantGroups && variantGroups.length > 0;
          var hasVariants = !hasGroups && variants && variants.length > 0;
          var hasVariantSelection = hasGroups || hasVariants;
          function colorsForVariant(v) { return (v && v.colors && v.colors.length > 0) ? v.colors : generalColors; }
          var activeGroup = hasGroups ? variantGroups[0] : null;
          var activeGroupVariants = hasGroups ? activeGroup.variants : variants;
          var activeVariant = hasVariantSelection && activeGroupVariants.length > 0 ? activeGroupVariants[0] : null;
          var activeColors = activeVariant ? colorsForVariant(activeVariant) : generalColors;
          var hasColors = activeColors && activeColors.length > 0;
          var activeColor = hasColors ? activeColors[0] : null;
          var activePrice = activeColor && activeColor.price != null ? activeColor.price : (activeVariant ? activeVariant.price : null);
          var effectiveInStock = product.in_stock && (activeVariant ? activeVariant.in_stock : true) && (activeColor ? activeColor.in_stock : true);
        %>

        <% if (hasVariantSelection) { %>
          <script type="application/json" id="variantColorData"><%- JSON.stringify({
            variantGroups: (variantGroups || []).map(function(g) {
              return {
                id: g.id, name: g.name,
                variants: g.variants.map(function(v) {
                  return {
                    id: v.id, label: v.label, price: v.price, inStock: !!v.in_stock,
                    colors: v.colors.map(function(c) {
                      return { id: c.id, name: c.name, hex: c.hex_code, price: c.price, inStock: !!c.in_stock };
                    })
                  };
                })
              };
            }),
            variants: (variants || []).map(function(v) {
              return {
                id: v.id, label: v.label, price: v.price, inStock: !!v.in_stock,
                colors: v.colors.map(function(c) {
                  return { id: c.id, name: c.name, hex: c.hex_code, price: c.price, inStock: !!c.in_stock };
                })
              };
            }),
            generalColors: generalColors.map(function(c) {
              return { id: c.id, name: c.name, hex: c.hex_code, price: null, inStock: !!c.in_stock };
            })
          }) %></script>
        <% } %>

        <div class="product-price product-price-lg" id="productPriceBlock">
          <% if (product.is_contact_price) { %>
            <span class="price-current price-contact">Liên hệ</span>
          <% } else if (hasVariantSelection) { %>
            <span class="price-current" id="variantPriceDisplay"><%= formatVND(activePrice) %></span>
          <% } else { %>
            <% var hasSale = product.sale_price && product.sale_price < product.price; %>
            <span class="price-current"><%= formatVND(hasSale ? product.sale_price : product.price) %></span>
            <% if (hasSale) { %>
              <span class="price-original"><%= formatVND(product.price) %></span>
              <span class="badge-sale">-<%= discountPercent(product.price, product.sale_price) %>%</span>
            <% } %>
          <% } %>
        </div>

        <% if (product.is_contact_price) { %>
          <a href="tel:<%= hotline.replace(/\s/g, '') %>" class="btn btn-primary btn-lg">Liên hệ đặt mua: <%= hotline %></a>
        <% } else if (!product.in_stock) { %>
          <p class="product-stock product-stock-out">Hết hàng</p>
          <button type="button" class="btn btn-outline btn-lg" disabled>Hết hàng</button>
        <% } else { %>
          <% if (hasGroups) { %>
            <div class="variant-picker" id="groupPicker">
              <label><%= product.variant_group_label %></label>
              <div class="variant-options" id="groupOptionsWrap">
                <% variantGroups.forEach(function(g, i) { %>
                  <button type="button" class="variant-option <%= i === 0 ? 'active' : '' %>" data-group-id="<%= g.id %>"><%= g.name %></button>
                <% }); %>
              </div>
            </div>
            <div class="variant-picker" id="variantPicker">
              <label>Dung lượng</label>
              <div class="variant-options" id="variantOptionsWrap">
                <% activeGroupVariants.forEach(function(v, i) { %>
                  <button type="button" class="variant-option <%= i === 0 ? 'active' : '' %>" data-variant-id="<%= v.id %>" data-price="<%= v.price %>" data-in-stock="<%= v.in_stock ? '1' : '0' %>" <%= v.in_stock ? '' : 'disabled' %>><%= v.label %></button>
                <% }); %>
              </div>
            </div>
          <% } else if (hasVariants) { %>
            <div class="variant-picker" id="variantPicker">
              <label>Dung lượng</label>
              <div class="variant-options" id="variantOptionsWrap">
                <% variants.forEach(function(v, i) { %>
                  <button type="button" class="variant-option <%= i === 0 ? 'active' : '' %>" data-variant-id="<%= v.id %>" data-price="<%= v.price %>" data-in-stock="<%= v.in_stock ? '1' : '0' %>" <%= v.in_stock ? '' : 'disabled' %>><%= v.label %></button>
                <% }); %>
              </div>
            </div>
          <% } %>

          <div class="color-picker" id="colorPicker" <%= hasColors ? '' : 'hidden' %>>
            <label>Màu sắc<span id="colorNameDisplay"><%= activeColor ? activeColor.name : '' %></span></label>
            <div class="color-options">
              <% activeColors.forEach(function(c, i) { %>
                <button type="button" class="color-option <%= i === 0 ? 'active' : '' %>" data-color-id="<%= c.id %>" data-color-name="<%= c.name %>" data-in-stock="<%= c.in_stock ? '1' : '0' %>" style="background-color: <%= c.hex_code %>;" title="<%= c.name %>" <%= c.in_stock ? '' : 'disabled' %>></button>
              <% }); %>
            </div>
          </div>

          <p class="product-stock" id="productStockText"><%= effectiveInStock ? 'Còn hàng' : 'Hết hàng' %></p>

          <form action="/gio-hang/them" method="post" class="add-to-cart-form-detail" id="productDetailCartForm">
            <input type="hidden" name="productId" value="<%= product.id %>" />
            <% if (hasVariantSelection && activeVariant) { %>
              <input type="hidden" name="variantId" id="variantIdInput" value="<%= activeVariant.id %>" />
            <% } %>
            <input type="hidden" name="colorId" id="colorIdInput" value="<%= activeColor ? activeColor.id : '' %>" />
            <div class="product-detail-cta-row">
              <button type="submit" name="intent" value="add" id="addToCartBtn" class="btn btn-outline btn-lg" <%= effectiveInStock ? '' : 'disabled' %>>
                <% if (effectiveInStock) { %>
                  <span class="btn-text-full">Thêm vào giỏ hàng</span><span class="btn-text-short">Thêm vào giỏ</span>
                <% } else { %>Hết hàng<% } %>
              </button>
              <button type="submit" name="intent" value="checkout" formaction="/thanh-toan/mua-ngay" class="btn btn-primary btn-lg" <%= effectiveInStock ? '' : 'disabled' %>>
                <% if (effectiveInStock) { %>
                  <span class="btn-text-full">Đặt hàng ngay</span><span class="btn-text-short">Đặt hàng</span>
                <% } else { %>Hết hàng<% } %>
              </button>
            </div>
          </form>
        <% } %>

        <%- include('partials/policy-list', { policies: policies }) %>

        <% if (product.description) { %>
          <div class="product-description">
            <h2>Mô tả sản phẩm</h2>
            <p><%= product.description %></p>
          </div>
        <% } %>

        <% var specKeys = Object.keys(specs); %>
        <% if (specKeys.length > 0) { %>
          <div class="product-specs">
            <h2>Thông số kỹ thuật</h2>
            <table>
              <tbody>
                <% specKeys.forEach(function(key) { %>
                  <tr><th><%= key %></th><td><%= specs[key] %></td></tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>

    <% if (related.length > 0) { %>
      <section class="category-section">
        <div class="section-heading"><h2>Sản phẩm liên quan</h2></div>
        <div class="product-grid">
          <% related.forEach(function(p) { %>
            <%- include('partials/product-card', { product: p }) %>
          <% }); %>
        </div>
      </section>
    <% } %>
  </div>
</main>

<%- include('partials/footer') %>
<script src="/js/main.js"></script>
</body>
</html>
