<!doctype html>
<html lang="vi">
<head>
<%- include('partials/head') %>
</head>
<body>
<%- include('partials/header') %>

<main>
  <div class="container page-container">
    <nav class="breadcrumb">
      <a href="/">Trang chủ</a> / <a href="/danh-muc/<%= category.slug %>"><%= category.name %></a> / <span><%= product.name %></span>
    </nav>

    <div class="product-detail">
      <div class="product-gallery">
        <div class="product-gallery-main" id="galleryMain">
          <% if (images.length > 0) { %>
            <% images.forEach(function(src, i) { %>
              <div class="gallery-slide <%= i === 0 ? 'is-active' : '' %>" data-index="<%= i %>">
                <img src="<%= src %>" alt="<%= product.name %> - ảnh <%= i + 1 %>" />
              </div>
            <% }); %>
            <% if (images.length > 1) { %>
              <button type="button" class="hero-slider-arrow prev" id="galleryPrev" aria-label="Ảnh trước">&larr;</button>
              <button type="button" class="hero-slider-arrow next" id="galleryNext" aria-label="Ảnh sau">&rarr;</button>
            <% } %>
          <% } else { %>
            <span class="product-icon-placeholder product-icon-placeholder-lg"><%- categoryIcon(category.slug) %></span>
          <% } %>
        </div>
        <% if (images.length > 1) { %>
          <div class="product-gallery-thumbs">
            <% images.forEach(function(src, i) { %>
              <button type="button" class="gallery-thumb <%= i === 0 ? 'active' : '' %>" data-index="<%= i %>">
                <img src="<%= src %>" alt="<%= product.name %> - ảnh <%= i + 1 %>" loading="lazy" />
              </button>
            <% }); %>
          </div>
        <% } %>
      </div>

      <div class="product-detail-info">
        <% if (product.brand) { %><span class="product-brand"><%= product.brand %></span><% } %>
        <h1><%= product.name %></h1>

        <div class="product-price product-price-lg">
          <% if (product.is_contact_price) { %>
            <span class="price-current price-contact">Liên hệ</span>
          <% } else { %>
            <% var hasSale = product.sale_price && product.sale_price < product.price; %>
            <span class="price-current"><%= formatVND(hasSale ? product.sale_price : product.price) %></span>
            <% if (hasSale) { %>
              <span class="price-original"><%= formatVND(product.price) %></span>
              <span class="badge-sale">-<%= discountPercent(product.price, product.sale_price) %>%</span>
            <% } %>
          <% } %>
        </div>

        <% if (product.is_contact_price) { %>
          <a href="tel:<%= hotline.replace(/\s/g, '') %>" class="btn btn-primary btn-lg">Liên hệ đặt mua: <%= hotline %></a>
        <% } else { %>
          <p class="product-stock"><%= product.stock > 0 ? 'Còn hàng' : 'Tạm hết hàng' %></p>

          <form action="/gio-hang/them" method="post" class="add-to-cart-form-detail" id="productDetailCartForm">
            <input type="hidden" name="productId" value="<%= product.id %>" />
            <label for="quantity">Số lượng</label>
            <input type="number" id="quantity" name="quantity" value="1" min="1" max="<%= Math.max(product.stock, 1) %>" />
            <div class="product-detail-cta-row">
              <button type="submit" name="intent" value="add" class="btn btn-outline btn-lg" <%= product.stock <= 0 ? 'disabled' : '' %>>Thêm vào giỏ hàng</button>
              <button type="submit" name="intent" value="checkout" class="btn btn-primary btn-lg" <%= product.stock <= 0 ? 'disabled' : '' %>>Thanh toán ngay</button>
            </div>
          </form>
        <% } %>

        <%- include('partials/policy-list', { policies: policies }) %>

        <% if (product.description) { %>
          <div class="product-description">
            <h2>Mô tả sản phẩm</h2>
            <p><%= product.description %></p>
          </div>
        <% } %>

        <% var specKeys = Object.keys(specs); %>
        <% if (specKeys.length > 0) { %>
          <div class="product-specs">
            <h2>Thông số kỹ thuật</h2>
            <table>
              <tbody>
                <% specKeys.forEach(function(key) { %>
                  <tr><th><%= key %></th><td><%= specs[key] %></td></tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>

    <% if (related.length > 0) { %>
      <section class="category-section">
        <div class="section-heading"><h2>Sản phẩm liên quan</h2></div>
        <div class="product-grid">
          <% related.forEach(function(p) { %>
            <%- include('partials/product-card', { product: p }) %>
          <% }); %>
        </div>
      </section>
    <% } %>
  </div>
</main>

<%- include('partials/footer') %>
<script src="/js/main.js"></script>
</body>
</html>
