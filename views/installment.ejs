<!doctype html>
<html lang="vi">
<head>
<%- include('partials/head') %>
</head>
<body>
<%- include('partials/header') %>

<main>
  <div class="container page-container">
    <nav class="breadcrumb">
      <a href="/">Trang chủ</a> / <span>Trả Góp Linh Động</span>
    </nav>

    <div class="section-heading"><h1>Trả Góp Linh Động</h1></div>

    <div class="installment-page">
      <div class="installment-tabs" id="installmentTabs">
        <button type="button" class="installment-tab active" data-target="panel-tin-dung"><%= tinDung.title %></button>
        <button type="button" class="installment-tab" data-target="panel-ngan-hang"><%= nganHang.title %></button>
      </div>

      <section class="installment-block" id="panel-tin-dung">
        <% if (tinDung.content_html) { %>
          <div class="installment-content"><%- tinDung.content_html %></div>
        <% } else { %>
          <p class="empty-state">Nội dung đang được cập nhật.</p>
        <% } %>
      </section>

      <section class="installment-block" id="panel-ngan-hang" hidden>
        <% if (nganHang.content_html) { %>
          <div class="installment-content"><%- nganHang.content_html %></div>
        <% } else { %>
          <p class="empty-state">Nội dung đang được cập nhật.</p>
        <% } %>
      </section>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
<script src="/js/main.js"></script>
<script>
  (function () {
    var tabs = document.querySelectorAll('.installment-tab');
    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        tabs.forEach(function (t) { t.classList.toggle('active', t === tab); });
        var targetId = tab.getAttribute('data-target');
        document.querySelectorAll('.installment-block').forEach(function (panel) {
          panel.hidden = panel.id !== targetId;
        });
      });
    });
  })();
</script>
</body>
</html>
