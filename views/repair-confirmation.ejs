<!doctype html>
<html lang="vi">
<head>
<%- include('partials/head') %>
</head>
<body>
<%- include('partials/header') %>

<main>
  <div class="container page-container">
    <div class="order-confirmation">
      <div class="order-confirmation-icon">
        <svg width="56" height="56" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.6"/><path d="M8 12.5l2.5 2.5L16 9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      <h1>Đã gửi yêu cầu sửa chữa!</h1>
      <p>Mã yêu cầu của bạn: <strong><%= request.request_code %></strong></p>

      <div class="order-instructions">
        <h2>Bước tiếp theo</h2>
        <ul>
          <li>TOMSTORE sẽ gọi lại theo số điện thoại bạn đã để lại để xác nhận và hẹn lịch nhận máy.</li>
          <li>Chi phí cuối cùng sẽ được chốt sau khi kiểm tra máy trực tiếp.</li>
          <li>Thời gian liên hệ thường trong giờ hành chính, sớm nhất có thể.</li>
        </ul>
      </div>

      <table class="cart-table">
        <thead><tr><th>Dịch vụ</th><th>Sản phẩm</th><th>Loại</th><th>Giá</th></tr></thead>
        <tbody>
          <% items.forEach(function(it) { %>
            <tr><td><%= it.service_name %></td><td><%= it.device_name %></td><td><%= it.variant_label %></td><td><%= formatVND(it.price) %></td></tr>
          <% }); %>
          <tr><td colspan="3"><strong>Tổng cộng</strong></td><td><strong><%= formatVND(request.total_price) %></strong></td></tr>
        </tbody>
      </table>
      <% if (request.note) { %>
        <p><strong>Ghi chú:</strong> <%= request.note %></p>
      <% } %>

      <a href="/" class="btn btn-primary btn-lg">Tiếp tục xem sản phẩm</a>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
<script src="/js/main.js"></script>
</body>
</html>
