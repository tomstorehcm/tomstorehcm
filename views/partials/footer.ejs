      <ul>
        <li>Hotline: <%= hotline %></li>
        <li>Email: cskh@tomstore.vn</li>
        <li>Địa chỉ: 123 Đường Công Nghệ, TP. Hồ Chí Minh</li>
      </ul>
    </div>
