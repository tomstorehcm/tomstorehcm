<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-col">
      <div class="footer-logo"><img src="/images/logo/tom-logo.png" alt="TOMSTORE" /></div>
      <p class="footer-slogan">Chuyên các sản phẩm Apple</p>
      <p>Cam kết chính hãng, giá tốt, bảo hành uy tín tại TP. Hồ Chí Minh.</p>
    </div>
    <div class="footer-col">
      <h4>Danh mục</h4>
      <ul>
        <% categories.forEach(function(cat) { %>
          <li><a href="/danh-muc/<%= cat.slug %>"><%= cat.name %></a></li>
        <% }); %>
      </ul>
    </div>
    <div class="footer-col">
      <h4>Chính sách</h4>
      <ul>
        <li>Bảo hành 2 năm phần cứng</li>
        <li>1 đổi 1 trong 60 ngày</li>
        <li>Bảo hành pin trọn đời</li>
        <li>Giao hàng toàn quốc</li>
        <li>Thanh toán COD / Chuyển khoản</li>
      </ul>
    </div>
    <div class="footer-col">
      <h4>Liên hệ</h4>
      <ul>
        <li>Hotline: <%= hotline %></li>
        <li>Email: cskh@tomstore.vn</li>
        <li>Địa chỉ: 96 Hồ Bá Kiện, Hoà Hưng, TP. Hồ Chí Minh</li>
      </ul>
    </div>
  </div>
  <div class="footer-bottom">
    <div class="container">&copy; <%= new Date().getFullYear() %> TOMSTORE. Tất cả các quyền được bảo lưu.</div>
  </div>
</footer>
