<%
  var isCompact = typeof compact !== 'undefined' && compact;
  var list = typeof policies !== 'undefined' ? policies : [];
%>
<% if (list.length > 0) { %>
<div class="policy-list <%= isCompact ? 'policy-list-compact' : '' %>">
  <% if (!isCompact) { %><h2 class="policy-list-heading">Chính sách bảo hành</h2><% } %>
  <ul>
    <% list.forEach(function(p) { %>
      <li class="policy-item">
        <span class="policy-icon"><%- getPolicyIcon(p.icon) %></span>
        <span class="policy-text">
          <strong><%= p.title %></strong>
          <% if (!isCompact && p.description) { %><span><%= p.description %></span><% } %>
        </span>
      </li>
    <% }); %>
  </ul>
</div>
<% } %>
