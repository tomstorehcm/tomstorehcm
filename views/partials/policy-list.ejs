<%
  var isCompact = typeof compact !== 'undefined' && compact;
  var policies = [
    {
      title: 'Bảo hành 2 năm phần cứng',
      desc: 'Không bao gồm rơi rớt, vô nước',
      icon: '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6l7-3Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>'
    },
    {
      title: '1 đổi 1 trong 60 ngày',
      desc: 'Khi phát sinh lỗi từ nhà sản xuất',
      icon: '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12a8 8 0 0 1 13.7-5.7L20 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M20 4v4h-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M20 12a8 8 0 0 1-13.7 5.7L4 16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M4 20v-4h4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>'
    },
    {
      title: 'Màn hình bảo hành 1 năm',
      desc: 'Lỗi xanh, trắng màn',
      icon: '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="4" width="18" height="13" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M8 21h8M12 17v4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>'
    },
    {
      title: 'Bảo hành pin trọn đời',
      desc: 'Thay miễn phí khi pin còn dưới 75%',
      icon: '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="2" y="8" width="17" height="8" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M21 10.5v3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M6 8v8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>'
    },
    {
      title: 'Phụ kiện tặng kèm bảo hành trọn đời',
      desc: 'Sạc, cáp, ốp lưng... đi kèm sản phẩm',
      icon: '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 8H4a1 1 0 0 0-1 1v3a1 1 0 0 0 1 1h16a1 1 0 0 0 1-1V9a1 1 0 0 0-1-1Z" stroke="currentColor" stroke-width="1.6"/><path d="M12 8v13M4 13v6a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M12 8c-1.5 0-3-1-3-2.5A2 2 0 0 1 11 3c1.5 0 1.8 2 1 5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M12 8c1.5 0 3-1 3-2.5A2 2 0 0 0 13 3c-1.5 0-1.8 2-1 5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>'
    }
  ];
%>
<div class="policy-list <%= isCompact ? 'policy-list-compact' : '' %>">
  <% if (!isCompact) { %><h2 class="policy-list-heading">Chính sách bảo hành</h2><% } %>
  <ul>
    <% policies.forEach(function(p) { %>
      <li class="policy-item">
        <span class="policy-icon"><%- p.icon %></span>
        <span class="policy-text">
          <strong><%= p.title %></strong>
          <% if (!isCompact) { %><span><%= p.desc %></span><% } %>
        </span>
      </li>
    <% }); %>
  </ul>
</div>
