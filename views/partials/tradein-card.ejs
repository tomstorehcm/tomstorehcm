<article class="product-card tradein-card" data-trade-in-product-id="<%= p.id %>">
  <div class="product-card-image">
    <% if (p.imageUrl) { %>
      <img src="<%= p.imageUrl %>" alt="<%= p.name %>" loading="lazy" width="300" height="300" />
    <% } else { %>
      <span class="product-icon-placeholder"><%- categoryIcon('') %></span>
    <% } %>
  </div>
  <div class="product-card-body">
    <h3 class="product-name"><%= p.name %></h3>
    <div class="product-price">
      <span class="tradein-price-label">Giá thu đến</span>
      <span class="price-current"><%= formatVND(p.maxPrice) %></span>
    </div>
    <% if (p.subsidyAmount) { %>
      <p class="tradein-subsidy-line">+ Trợ giá thu cũ đến <strong><%= formatVND(p.subsidyAmount) %></strong></p>
    <% } %>
    <div class="tradein-card-actions">
      <button type="button" class="btn btn-flow btn-block tradein-start-btn" data-trade-in-product-id="<%= p.id %>">Chọn sản phẩm</button>
    </div>
  </div>
</article>
