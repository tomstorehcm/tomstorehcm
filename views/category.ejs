<!doctype html>
<html lang="vi">
<head>
<%- include('partials/head') %>
</head>
<body>
<%- include('partials/header') %>

<main>
  <div class="container page-container">
    <nav class="breadcrumb"><a href="/">Trang chủ</a> / <span><%= category.name %></span></nav>

    <div class="section-heading">
      <h1><%= category.name %></h1>
      <form action="/danh-muc/<%= category.slug %>" method="get" class="sort-form">
        <label for="sort">Sắp xếp:</label>
        <select name="sort" id="sort" onchange="this.form.submit()">
          <option value="newest" <%= sort === 'newest' ? 'selected' : '' %>>Mới nhất</option>
          <option value="price_asc" <%= sort === 'price_asc' ? 'selected' : '' %>>Giá tăng dần</option>
          <option value="price_desc" <%= sort === 'price_desc' ? 'selected' : '' %>>Giá giảm dần</option>
        </select>
      </form>
    </div>

    <% if (tabGroups.length > 1) { %>
      <div class="category-tabs" id="categoryTabs">
        <% tabGroups.forEach(function(group, i) { %>
          <button type="button" class="category-tab <%= i === 0 ? 'active' : '' %>" data-target="category-tab-panel-<%= i %>"><%= group.category.name %></button>
        <% }); %>
      </div>
      <% tabGroups.forEach(function(group, i) { %>
        <div class="category-tab-panel" id="category-tab-panel-<%= i %>" <%= i === 0 ? '' : 'hidden' %>>
          <% if (group.products.length === 0) { %>
            <p class="empty-state">Danh mục này hiện chưa có sản phẩm.</p>
          <% } else { %>
            <div class="product-grid">
              <% group.products.forEach(function(product) { %>
                <%- include('partials/product-card', { product: product }) %>
              <% }); %>
            </div>
          <% } %>
        </div>
      <% }); %>
      <script>
        (function () {
          var tabs = document.querySelectorAll('#categoryTabs .category-tab');
          var panels = document.querySelectorAll('.category-tab-panel');
          tabs.forEach(function (tab) {
            tab.addEventListener('click', function () {
              tabs.forEach(function (t) { t.classList.remove('active'); });
              panels.forEach(function (p) { p.hidden = true; });
              tab.classList.add('active');
              document.getElementById(tab.getAttribute('data-target')).hidden = false;
            });
          });
        })();
      </script>
    <% } else if (products.length === 0) { %>
      <p class="empty-state">Danh mục này hiện chưa có sản phẩm.</p>
    <% } else { %>
      <div class="product-grid">
        <% products.forEach(function(product) { %>
          <%- include('partials/product-card', { product: product }) %>
        <% }); %>
      </div>
    <% } %>
  </div>
</main>

<%- include('partials/footer') %>
<script src="/js/main.js"></script>
</body>
</html>
