<!doctype html>
<html lang="vi">
<head>
<%- include('partials/head') %>
</head>
<body>
<%- include('partials/header') %>

<main>
  <% if (banners.length > 0) { %>
  <div class="hero-slider-wrap container" id="heroWrap">
    <div class="hero-anim">
    <section class="hero-slider" id="heroSlider">
      <div class="hero-slider-track" id="heroSliderTrack">
        <% banners.forEach(function(banner) { %>
          <% var bannerPicture = '<picture>' + (banner.image_url_mobile ? '<source media="(max-width: 767px)" srcset="' + banner.image_url_mobile + '">' : '') + '<img src="' + banner.image_url + '" alt="TOMSTORE banner" /></picture>'; %>
          <div class="hero-slide">
            <% if (banner.link_url) { %>
              <a href="<%= banner.link_url %>"><%- bannerPicture %></a>
            <% } else { %>
              <span class="hero-slide-img"><%- bannerPicture %></span>
            <% } %>
          </div>
        <% }); %>
      </div>
      <div class="hero-slider-overlay" id="heroOverlay"></div>
      <% if (banners.length > 1) { %>
        <button type="button" class="hero-slider-arrow prev" id="heroPrev" aria-label="Ảnh trước">&larr;</button>
        <button type="button" class="hero-slider-arrow next" id="heroNext" aria-label="Ảnh sau">&rarr;</button>
        <div class="hero-slider-dots" id="heroDots">
          <% banners.forEach(function(banner, i) { %>
            <button type="button" class="<%= i === 0 ? 'active' : '' %>" data-index="<%= i %>" aria-label="Đến slide <%= i + 1 %>"></button>
          <% }); %>
        </div>
      <% } %>
    </section>
    </div>
  </div>
  <% } else { %>
  <section class="hero-fallback">
    <div class="container">
      <h1>Chuyên các sản phẩm Apple</h1>
      <p>iPhone, MacBook, iPad, AirPods chính hãng - bảo hành 12 tháng, giao hàng toàn quốc.</p>
    </div>
  </section>
  <% } %>

  <% if (hotDeals.length > 0) { %>
  <section id="hot-deal" class="hot-deal-section">
    <div class="container">
      <div class="hot-deal-card">
        <div class="section-heading-hotdeal">
          <h2>Hot Deal Trong Ngày</h2>
          <p>Ưu đãi có hạn - nhanh tay đặt hàng trước khi hết giờ</p>
        </div>
        <div class="product-grid hotdeal-grid">
          <% hotDeals.forEach(function(product) { %>
            <%- include('partials/hotdeal-card', { product: product }) %>
          <% }); %>
        </div>
      </div>
    </div>
  </section>
  <% } %>

  <div class="container">
    <% if (homeCategories.length > 4) { %>
      <div class="category-tiles-slider-wrap">
        <div class="category-tiles category-tiles-slider" id="categoryTilesSlider">
          <% homeCategories.forEach(function(cat) { %>
            <a href="/danh-muc/<%= cat.slug %>" class="category-tile">
              <% if (cat.image_url) { %>
                <img src="<%= cat.image_url %>" alt="<%= cat.name %>" loading="lazy" />
              <% } else { %>
                <span class="category-tile-placeholder"><%- categoryIcon(cat.slug) %></span>
              <% } %>
              <span class="category-tile-label"><%= cat.name %></span>
            </a>
          <% }); %>
        </div>
        <button type="button" class="hero-slider-arrow prev" id="categoryPrev" aria-label="Danh mục trước">&larr;</button>
        <button type="button" class="hero-slider-arrow next" id="categoryNext" aria-label="Danh mục sau">&rarr;</button>
      </div>
    <% } else { %>
      <div class="category-tiles">
        <% homeCategories.forEach(function(cat) { %>
          <a href="/danh-muc/<%= cat.slug %>" class="category-tile">
            <% if (cat.image_url) { %>
              <img src="<%= cat.image_url %>" alt="<%= cat.name %>" loading="lazy" />
            <% } else { %>
              <span class="category-tile-placeholder"><%- categoryIcon(cat.slug) %></span>
            <% } %>
            <span class="category-tile-label"><%= cat.name %></span>
          </a>
        <% }); %>
      </div>
    <% } %>
  </div>

  <% if (featuredProducts.length > 0) { %>
  <section class="featured-section">
    <div class="container">
      <div class="section-heading">
        <h2>Sản phẩm Hot</h2>
      </div>
      <div class="featured-layout">
        <% if (featuredBanner) { %>
          <a href="<%= featuredBanner.link_url || ('tel:' + hotline.replace(/\s/g, '')) %>" class="featured-banner">
            <img src="<%= featuredBanner.image_url %>" alt="TOMSTORE" loading="lazy" />
          </a>
        <% } %>
        <div class="featured-products">
          <% featuredProducts.forEach(function(product) { %>
            <%- include('partials/product-card', { product: product }) %>
          <% }); %>
        </div>
      </div>
    </div>
  </section>
  <% } %>

  <% sections.forEach(function(section) { %>
    <% if (section.products.length > 0) { %>
    <section class="category-section">
      <div class="container">
        <div class="section-heading">
          <h2><%= section.category.name %></h2>
          <a href="/danh-muc/<%= section.category.slug %>" class="see-all-link">Xem tất cả &rarr;</a>
        </div>
        <div class="product-grid">
          <% section.products.forEach(function(product) { %>
            <%- include('partials/product-card', { product: product }) %>
          <% }); %>
        </div>
      </div>
    </section>
    <% } %>
  <% }); %>
</main>

<%- include('partials/footer') %>
<script src="/js/main.js"></script>
</body>
</html>
