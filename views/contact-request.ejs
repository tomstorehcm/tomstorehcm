<!doctype html>
<html lang="vi">
<head>
<%- include('partials/head') %>
</head>
<body>
<%- include('partials/header') %>

<main>
  <div class="container page-container">
    <div class="section-heading"><h1>Liên hệ báo giá</h1></div>

    <% if (errors.length > 0) { %>
      <div class="form-errors">
        <ul>
          <% errors.forEach(function(e) { %><li><%= e.msg %></li><% }); %>
        </ul>
      </div>
    <% } %>

    <div class="checkout-layout">
      <form action="/lien-he-bao-gia" method="post" class="checkout-form">
        <input type="hidden" name="productId" value="<%= productId %>" />
        <input type="hidden" name="variantId" value="<%= variantId %>" />
        <input type="hidden" name="colorId" value="<%= colorId %>" />
        <div class="form-group">
          <label for="customerName">Họ và tên *</label>
          <input type="text" id="customerName" name="customerName" value="<%= formData.customerName || '' %>" required />
        </div>
        <div class="form-group">
          <label for="phone">Số điện thoại *</label>
          <input type="tel" id="phone" name="phone" value="<%= formData.phone || '' %>" placeholder="09xxxxxxxx" required />
        </div>
        <div class="form-group">
          <label for="note">Ghi chú (không bắt buộc)</label>
          <textarea id="note" name="note" rows="3" placeholder="Nhắn thêm nếu bạn cần..."><%= formData.note || '' %></textarea>
        </div>
        <small>Vui lòng để lại thông tin, TOMSTORE sẽ gọi lại báo giá trong thời gian sớm nhất.</small>
        <button type="submit" class="btn btn-primary btn-lg btn-block">Gửi yêu cầu liên hệ</button>
      </form>

      <aside class="cart-summary">
        <h2>Sản phẩm quan tâm</h2>
        <p><%= contextLabel %></p>
        <p class="price-current price-contact">Liên hệ</p>
      </aside>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
<script src="/js/main.js"></script>
</body>
</html>
