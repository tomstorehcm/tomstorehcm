<!doctype html>
<html lang="vi">
<head>
<%- include('partials/head') %>
</head>
<body>
<%- include('partials/header') %>

<main>
  <div class="container page-container">
    <div class="order-confirmation">
      <div class="order-confirmation-icon">
        <svg width="56" height="56" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.6"/><path d="M8 12.5l2.5 2.5L16 9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      <h1>Đặt hàng thành công!</h1>
      <p>Mã đơn hàng của bạn: <strong><%= order.order_code %></strong></p>

      <div class="order-instructions">
        <h2><%= instructions.title %></h2>
        <ul>
          <% instructions.lines.forEach(function(line) { %><li><%= line %></li><% }); %>
        </ul>
      </div>

      <table class="cart-table">
        <thead><tr><th>Sản phẩm</th><th>Đơn giá</th><th>Số lượng</th><th>Thành tiền</th></tr></thead>
        <tbody>
          <% items.forEach(function(item) { %>
            <tr>
              <td><%= item.product_name %></td>
              <td><%= formatVND(item.price) %></td>
              <td><%= item.quantity %></td>
              <td><%= formatVND(item.price * item.quantity) %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
      <div class="cart-summary-row order-total-row"><span>Tổng cộng</span><strong><%= formatVND(order.total) %></strong></div>

      <a href="/" class="btn btn-primary btn-lg">Tiếp tục mua sắm</a>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
<script src="/js/main.js"></script>
</body>
</html>
