<!doctype html>
<html lang="vi">
<head>
<%- include('partials/head') %>
</head>
<body>
<%- include('partials/header') %>

<main>
  <div class="container page-container">
    <div class="section-heading"><h1>Giỏ hàng</h1></div>

    <%
      function cartItemVariantText(item) {
        var parts = [];
        if (item.variant) parts.push(item.variant.label);
        if (item.color) parts.push(item.color.name);
        return parts.length > 0 ? ' (' + parts.join(', ') + ')' : '';
      }
    %>
    <div id="cartContent" class="cart-content">
    <% if (cart.items.length === 0) { %>
      <p class="empty-state">Giỏ hàng của bạn đang trống. <a href="/">Tiếp tục mua sắm</a></p>
    <% } else { %>
      <div class="cart-layout">
        <table class="cart-table">
          <thead>
            <tr><th>Sản phẩm</th><th>Đơn giá</th><th></th></tr>
          </thead>
          <tbody>
            <% cart.items.forEach(function(item) { %>
              <tr>
                <td class="cart-product-cell">
                  <a href="/san-pham/<%= item.product.slug %>"><%= item.product.name %><% var variantText = cartItemVariantText(item); %><% if (variantText) { %> <span class="cart-item-variant"><%= variantText %></span><% } %></a>
                </td>
                <td class="cart-line-total"><%= formatVND(item.unitPrice) %></td>
                <td>
                  <form action="/gio-hang/xoa" method="post" class="cart-remove-form">
                    <input type="hidden" name="productId" value="<%= item.product.id %>" />
                    <% if (item.variant) { %><input type="hidden" name="variantId" value="<%= item.variant.id %>" /><% } %>
                    <% if (item.color) { %><input type="hidden" name="colorId" value="<%= item.color.id %>" /><% } %>
                    <button type="submit" class="btn-remove" aria-label="Xóa sản phẩm">&times;</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>

        <aside class="cart-summary">
          <h2>Tổng cộng</h2>
          <div class="cart-summary-row"><span>Tạm tính</span><strong id="cartSummaryTotal"><%= formatVND(cart.total) %></strong></div>
          <a href="/thanh-toan" class="btn btn-primary btn-lg btn-block">Tiến hành thanh toán</a>
          <a href="/" class="btn btn-outline btn-block">Tiếp tục mua sắm</a>
        </aside>
      </div>
    <% } %>
    </div>
    <template id="cartEmptyTemplate"><p class="empty-state">Giỏ hàng của bạn đang trống. <a href="/">Tiếp tục mua sắm</a></p></template>
  </div>
</main>

<%- include('partials/footer') %>
<script src="/js/main.js"></script>
</body>
</html>
